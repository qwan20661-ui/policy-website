# 政策融合 LLM 服务配置
# 复制为 .env 后修改

# LLM API 配置（兼容 OpenAI 格式）
METADATA_API_URL=http://127.0.0.1:8000/v1/chat/completions
METADATA_API_KEY=
METADATA_MODEL_NAME=qwen-32B

# 请求参数
METADATA_REQUEST_TIMEOUT=300
METADATA_CONNECT_TIMEOUT=30
METADATA_MAX_RETRIES=2
METADATA_TEMPERATURE=0.7
METADATA_MAX_TEXT_LENGTH=12000

# 服务配置
FUSION_SERVICE_HOST=0.0.0.0
FUSION_SERVICE_PORT=8001

# 融合数据根目录（默认读取盘符）
FUSION_DATA_DIR=D:\kejiju\metadata\重点政策融合数据

# JDBC 中间层服务地址（融合时通过该服务从数据库获取关联文档原文）
JDBC_SERVICE_URL=http://localhost:8080
