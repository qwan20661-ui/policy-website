# LLM API配置（修改为你实际使用的地址和密钥）
API_URL=http://127.0.0.1:3000/v1/chat/completions
API_KEY=
MODEL_NAME=qwen3-8b
RULE_LLM_TIMEOUT=300

# 并发配置
# 唯一并发配置：同时拉取主政策详情；匹配时作为全局 LLM 条件任务队列的并发上限
MAX_WORKERS=20

# 路径配置（兼容旧脚本）
ENTERPRISE_DIR=backend/PEMatching/企业测试
POLICY_DIR=backend/PEMatching/policydata
OUTPUT_DIR=backend/PEMatching

# 新后端匹配链路配置
POLICY_SOURCE=structure_api
ENTERPRISE_JSON_PATH=backend/PEMatching/Enterprisedata/test.json
STRUCTURE_API_BASE_URL=http://127.0.0.1:8080
POLICY_PAGE_SIZE=100
# 每天首次全量同步主政策详情及申报条件到 config/主政策申报条件.json，后续接口和 CLI 直接读取当天快照
PEMATCHING_DAILY_POLICY_CACHE_ENABLED=true
OUTPUT_FILE=backend/PEMatching/llm_matching_results.json
PEMATCHING_HOST=0.0.0.0
PEMATCHING_PORT=8010
# 每次 HTTP 请求的独立运行日志目录，默认 backend/PEMatching/logs
PEMATCHING_API_LOG_DIR=backend/PEMatching/logs

PEMATCHING_ENTERPRISE_SOURCE=api
PEMATCHING_ENTERPRISE_API_BASE_URL=http://112.48.19.225:8500
PEMATCHING_ENTERPRISE_API_PATH=/cms/tb-base-business-info/web/page
PEMATCHING_ENTERPRISE_API_PAGE_SIZE=100
PEMATCHING_ENTERPRISE_API_MAX_PAGES=0
PEMATCHING_ENTERPRISE_API_TIMEOUT=15

# 首次请求之外的额外重试次数
SEMANTIC_MATCH_LLM_RETRIES=2

# 递增退避基础秒数：第1次等待0.5秒，第2次等待1秒
SEMANTIC_MATCH_LLM_RETRY_BACKOFF=0.5

# 单次语义模型请求超时
SEMANTIC_MATCH_LLM_TIMEOUT=90

# 同一政策的语义条件微批上限（1 保持逐条件模式；完成 A/B 验证后可试验 2/4/6/8/10）
SEMANTIC_MATCH_BATCH_SIZE=1

# 企业-政策关联匹配独立开关。上线前先完成固定企业/政策快照容量验证，再改为 true。
POLICY_ASSOCIATION_LLM_ENABLED=false
# 未单独配置时复用 API_URL、API_KEY、MODEL_NAME 和语义匹配的重试/超时配置。
# POLICY_ASSOCIATION_API_URL=http://127.0.0.1:3000/v1/chat/completions
# POLICY_ASSOCIATION_API_KEY=
# POLICY_ASSOCIATION_MODEL_NAME=qwen3-8b
POLICY_ASSOCIATION_LLM_TIMEOUT=90
POLICY_ASSOCIATION_LLM_RETRIES=2
POLICY_ASSOCIATION_LLM_RETRY_BACKOFF=0.5
