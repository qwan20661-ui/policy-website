    {
      "fusionPolicyId": "6678",
      "sourcePolicyId": "24068",
      "title": "厦门市高新技术企业认定中介机构资格认定申报",
      "updateTime": "2026-07-31 16:03:37.664463",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市高新技术企业认定中介机构资格认定申报",
        "summary": "厦门市高新技术企业认定中介机构资格确认是指对符合执业条件与人员标准的中介机构所进行审核，确认其具备出具高新技术企业认定专项报告资格的专项管理工作。该确认工作旨在规范认定中介市场，保障高企认定审计鉴证质量，通过设定人员比例、执业记录及报告出具数量上限等标准择优遴选专业机构，并提供免费业务培训，从而推动厦门市高新技术企业认定工作高效、有序开展。",
        "contactInfo": "1、咨询受理：厦门市高新技术发展协会；2、咨询电话：2052621、2025913、2052826；3、责任处室：市高企认定办(市科技局前沿技术与产业科技处)；4、电话：2661606。",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市高新技术企业认定管理机构关于开展2025年度厦门市高新技术企业认定中介机构资格确认工作的通知",
        "sceneUsage": "高新技术企业中介机构认定",
        "sceneUsagePath": "资质认定-高新技术企业中介机构认定",
        "applicableScope": "厦门市",
