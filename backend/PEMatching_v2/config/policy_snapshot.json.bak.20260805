    {
      "fusionPolicyId": "6462",
      "sourcePolicyId": "24035",
      "title": "厦门市福建省科学技术奖提名",
      "updateTime": "2026-08-03 09:57:55.534793",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市福建省科学技术奖提名",
        "summary": "厦门市福建省科学技术奖提名是指厦门市相关组织或个人按规定程序向福建省推荐科学技术成果或个人参评省级科技奖项的工作。该提名旨在奖励在科技进步活动中做出重要贡献的个人与组织，充分调动科技工作者积极性，推动科技创新与经济社会发展。经评审通过的项目可获颁证书与奖金，奖金依法免征个人所得税，获奖情况记入个人档案，适用于在福建省内开展基础研究、技术开发、成果转化及国际科技合作的主体。",
        "contactInfo": "1、市科技局科技资源配置处：0592-2051278\n2、市科技局信访举报电话：0592-2021808\n3、驻市科技局纪检监督电话：0592-2031996\n4、地址：厦门市思明区虎园路2号810室\n5、邮政编码：361003",
        "applicationVolume": "",
        "policyAttribute": "申报通知",
        "policyOriginalTitle": "厦门市科学技术局关于厦门市拟提名2025年度福建省科学技术奖项目补充公示",
        "sceneUsage": "科技创新奖励",
        "sceneUsagePath": "研发创新-科技创新奖励",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "",
        "effectiveEndDate": "长期",
        "issuingDepartment": "福建省人民政府",
        "policyCode": "福建省人民政府令第250号"
      },
      "supportMethods": [
        {
          "id": "1113",
          "supportType": "",
          "supportTypePath": "",
          "contentDesc": "第四章 授奖与监督\n第二十条 省科学技术重大贡献奖、省自然科学奖、省技术发明奖、省科学技术进步奖、省科学技术成果转化奖颁发证书、奖金，省国际科学技术合作奖颁发证书。\n第二十条\n省科学技术重大贡献奖的奖励荣誉和奖金由获奖人个人享有。省自然科学奖、省技术发明奖、省科学技术进步奖、省科学技术成果转化奖的奖励荣誉由项目成果主要完成单位和主要完成人共享，奖金由主要完成人按照贡献大小分配。\n省科学技术奖获奖人的获奖情况记入个人档案。\n第二十一条 省科学技术奖奖励所需经费纳入本级预算。各项奖金数额需要调整的，由省人民政府科学技术行政部门会同财政部门拟定方案，报省委、省人民政府批准。奖金依照《中华人民共和国个人所得税法》有关规定免征个人所得税。",
          "amount": "",
          "maxAmount": ""
        }
      ],
      "structuredConditions": [
        {
          "id": "1111",
          "applicableTarget": "个人；组织；外国人",
          "applicableTargetPath": "个人；组织；外国人",
          "applicationInstruction": "",
          "applicationRequirement": "第七条 省科学技术重大贡献奖授予下列个人：\n第七条\n（一）在当代科学技术前沿取得重大突破或者在科学技术发展中有突出建树的；\n（二）在我省科学技术创新、科学技术成果转化和高新技术产业化中，创造重大经济效益、社会效益或者生态环境效益的。\n第八条 省自然科学奖授予在基础研究和应用基础研究中阐明自然现象、特征和规律，做出重大科学发现的个人、组织。\n第八条\n前款所称重大科学发现，应当具备下列条件：\n（一）前人尚未发现或者尚未阐明；\n（二）具有重大科学价值；\n（三）得到国内外自然科学界公认。\n第九条 省技术发明奖授予在我省运用科学技术知识对产品、工艺、材料、器件及其系统等做出重大技术发明的个人、组织。\n第九条\n前款所称重大技术发明，应当具备下列条件：\n（一）前人尚未发明或者尚未公开；\n（二）具有先进性、创造性和实用性；\n（三）经实施，创造显著经济效益、社会效益、生态环境效益或者对维护国家安全做出显著贡献，且具有良好的应用前景。\n第十条 省科学技术进步奖授予在我省实施科学技术开发研究和应用创新性科学技术成果等方面，做出突出贡献的下列个人、组织：\n第十条\n（一）在实施技术开发项目中，完成重大技术创新，创造显著经济效益的；\n（二）在实施社会公益项目中，长期从事科学技术基础性工作和社会公益性科学技术事业，经过实践检验，创造了显著社会效益的；\n（三）在实施国家安全项目中，为推进国防现代化建设、保障国家安全做出重大科学技术贡献的；\n（四）在实施重大工程项目中，保障工程达到国内领先水平，并创造重大经济效益或者社会效益的。\n前款第四项的奖励仅授予组织。\n第十一条 省科学技术成果转化奖授予将自有的先进科学技术成果或者依法引进、消化吸收其他组织或者个人的先进科学技术成果，在本省落地转化并大规模应用或者大面积推广，提升产业的技术水平，并创造重大经济效益、社会效益或者生态环境效益的个人、组织。\n第十一条\n第十二条 省国际科学技术合作奖授予对我省科学技术事业做出重要贡献的外国人，候选人应当符合下列条件之一：\n第十二条\n（一）与我省个人或者组织进行合作研究、开发取得重大科学技术成果，对我省科学技术、经济发展有重要推动作用，并创造显著经济效益、社会效益或者生态环境效益的；\n（二）向我省个人或者组织传授先进科学技术、培养科学技术或者管理人才，成效特别显著的；\n（三）为促进我省与其他国家或者国际组织的科学技术交流与合作，做出重要贡献的。",
          "applicationStartTime": "",
          "applicationEndTime": "",
          "announcementDate": ""
        }
      ],
