    {
      "fusionPolicyId": "6568",
      "sourcePolicyId": "24101",
      "title": "科技型企业孵化器认定",
      "updateTime": "2026-07-30 17:38:02.392714",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "科技型企业孵化器认定",
        "summary": "科技型企业孵化器认定是指工业和信息化部对符合相关条件的科技创业服务机构开展标准级和卓越级资格认定的管理工作。该认定旨在推动科技创新与产业创新深度融合，强化高水平科技服务，提升孵化效能。经认定的孵化器可按规定享受相关支持政策，适用于为科技型初创企业和创业团队提供经营设施、创业辅导、技术支持及投资融资等专业服务的机构，有助于降低创业风险、促进企业成长并培育新质生产力。",
        "contactInfo": "1、咨询电话：2027808、2021361",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市科学技术局关于开展2025年工业和信息化部科技型企业孵化器申报工作的通知",
        "sceneUsage": "孵化器认定；孵化加速",
        "sceneUsagePath": "资质认定-孵化器认定；成果转化-孵化加速",
        "applicableScope": "国家级",
        "applicableScopePath": "国家级",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "2025-07-10",
        "effectiveEndDate": "长期",
        "issuingDepartment": "工业和信息化部办公厅",
        "policyCode": "工信部科〔2025〕131号"
      },
      "supportMethods": [
        {
          "id": "1179",
          "supportType": "一次性奖励补助",
          "supportTypePath": "资金补助-一次性奖励补助-                                             ",
          "contentDesc": "对新认定的部级孵化器，卓越级给予一次性500万元奖励，标准级给予一次性200万元奖励。根据考核或复核结果，每年给予市级及以上孵化器最高100万元运营补助。以上奖励补助合计每年每家孵化器最高500万元。",
          "amount": "",
          "maxAmount": "500万元"
        }
      ],
      "structuredConditions": [
        {
          "id": "1177",
          "applicableTarget": "企业类；事业单位；民办非企业单位",
          "applicableTargetPath": "企业类-国家级专精特新“小巨人”企业-      ；事业单位-高校；民办非企业单位-协会",
          "applicationInstruction": "2025年09月11日-2025年09月26日",
          "applicationRequirement": "标准级孵化器实行达标认定，应具备以下条件：\n　　（一）具有独立法人资格、完善的运营管理体系和较强的孵化服务能力。\n　　（二）具有稳定清晰的孵化场地，可自主支配（自有、租赁或协议使用）的孵化场地面积不低于5000平方米。\n　　（三）具备职业化运营团队，团队负责人具有相关产业背景、创业投资、技术洞察、企业管理等方面丰富经验；配备较强的专业孵化服务人员和创业导师，专职孵化服务人员占机构总人数80%以上，每10家在孵企业至少配备1名创业导师。\n　　（四）在孵企业不少于30家，其中上年度新增注册企业数占比不低于20%，科技型中小企业、创新型中小企业占比不低于30%。\n　　（五）上年度通过单独或出资合作设立的孵化资金、股权投资基金等完成股权投资且确权实缴的在孵企业占比不低于10%，或上年度获得投融资的在孵企业占比不低于20%。\n　　（六）上年度不少于30%的在孵企业营业收入或研发经费投入同比增长超过20%。\n　　（七）单独核算孵化服务收入，上年度除房租及物业之外的收入占总收入的比例不低于30%。\n　　（八）上年度至少10%的在孵企业成为毕业企业。\n　　（九）按照国家统计局批准的创新创业类服务机构统计调查制度，至少报送1年统计数据。\n　　（十）遵守国家法律法规，3年内未发生重大环保、质量和安全事故，未被列为严重失信主体，没有重大违法行为或涉嫌重大违法正在接受有关部门审查的情况。\n卓越级孵化器对标国际一流水平实行择优认定，应突出以下特征和功能：\n　　（一）强产业属性。聚焦新兴产业和未来产业领域，汇聚并服务一批早期创业项目和科技型企业，形成产业集聚效应和创新生态。近两年每年服务的细分产业领域的创业企业不少于30家。\n　　（二）强服务功能。聚焦前沿技术开展全链条科技成果转化服务，搭建专业技术服务平台，提供研发、设计、验证、检验、测试等专业服务；全方位赋能企业成长，提供产业对接、市场推广、企业管理等增值服务。近两年每年服务和投资收入占总收入比重不低于50%。\n　　（三）强人才牵引。管理团队由具有行业影响力的产学研复合型人才或在龙头企业具有资深从业经验的领军人才牵头组建，懂技术、懂创业、懂投资、懂产业；具有一支高水平专业孵化服务队伍。\n　　（四）强投资赋能。能够联动至少一支在中国证券投资基金业协会备案的细分产业领域股权投资基金，围绕服务企业投早、投小、投长期。\n　　（五）强加速效应。能够带动一批前沿技术成果转化落地，培育一批成长性好、发展潜力大的科技型企业，企业研发经费投入、营业收入等快速增长。",
          "applicationStartTime": "2025-09-11",
          "applicationEndTime": "2025-09-26",
          "announcementDate": ""
        }
      ],
      "keywords": [
        {
          "id": "2541",
          "text": "孵化器认定",
          "pathText": "资质认定-平台资质认定-孵化器认定"
        }
      ],
      "materials": [
        {
          "id": "1177",
          "materials": "申报书（标准级）、申报书（卓越级）等相关材料",
          "method": "（一）孵化器运营主体（需为独立法人）需使用统一社会信用代码，通过“统一身份认证与单点登录平台”（网址：https://hjrz.chinatorch.org.cn/login）进入孵化器管理与信息服务系统，按要求在线填报申报书（可同时申报标准级、卓越级，申报书见附件2、附件3）。\n（二）原国家级孵化器需登录孵化器管理与信息服务系统，对有关数据进行更新和补充。",
          "url": "https://hjrz.chinatorch.org.cn/login"
        }
      ],
