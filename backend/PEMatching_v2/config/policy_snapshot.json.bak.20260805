    {
      "fusionPolicyId": "6552",
      "sourcePolicyId": "24014",
      "title": "厦门市市级科技计划项目申报",
      "updateTime": "2026-08-03 16:03:04.357635",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市市级科技计划项目申报",
        "summary": "根据《厦门市关于进一步推动企业加大研发投入的若干措施》（厦科规〔2023〕1号）、《企业研发项目纳入市级重大科技计划项目实施细则》（厦科规〔2023〕5号）等规定，针对企业自筹实施且已结题的研发项目开展备案认定，成功备案可取得市级重大科技计划项目编号，视同承担市级科技计划项目，可作为申报各级科技扶持政策、资质认定的有效佐证（研发费用加计扣除政策除外）。项目需自研费用500万元以上、已验收合格、未获各级科技立项，企业年度最多申报两项。",
        "contactInfo": "1、厦门市技术创新协会，咨询电话：2029968、2029958、2029035。2、材料寄送地址：思明区虎园路2号科技大院5号楼406室。3、业务处室：市科技局科技资源配置处 联系电话：2057061。",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市科学技术局关于印发企业研发项目纳入市级重大科技计划项目实施细则的通知",
        "sceneUsage": "科技计划项目支持；研发创新项目申报；核心技术攻关",
        "sceneUsagePath": "研发创新-科技计划项目支持；研发创新-研发创新项目申报；研发创新-核心技术攻关",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "2024-02-01",
