    {
      "fusionPolicyId": "6551",
      "sourcePolicyId": "24013",
      "title": "厦门市国家科技重大项目资金配套申报",
      "updateTime": "2026-07-29 09:28:15.931536",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市国家科技重大项目资金配套申报",
        "summary": "厦门市国家科技重大项目资金配套申报通知是指对获得国家科技重大项目立项且实际获得中央财政资金的企业及相关单位给予市级配套支持的专项工作。该工作旨在激励相关单位积极承担国家科技重大项目，加快融入国家重大战略布局。配套资金按实际国拨经费给予最高50%支持，生物医药类按1:1比例配套，单个项目最高1000万元。资金用于项目研发与成果转化，适用于承担国家重点研发计划及重大专项的各类机构。",
        "contactInfo": "1、市科技局：思明区虎园路2号市科技局807室，联系人：陈女士，联系电话：2021878。\n2、主管部门：网上填报后待科技局通知材料报送地点及联系方式。\n3、申报系统技术咨询电话：0592-5397711",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市科学技术局关于组织申报2026年度国家科技重大项目资金配套的通知",
        "sceneUsage": "研发经费补助；科技计划项目支持",
        "sceneUsagePath": "研发创新-研发经费补助；研发创新-科技计划项目支持",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "2025.01.20",
        "effectiveEndDate": "2028.01.19",
        "issuingDepartment": "厦门市科学技术局",
        "policyCode": "厦科规〔2024〕4号"
      },
      "supportMethods": [
        {
          "id": "1091",
          "supportType": "研发专项补助、一次性奖励补助",
          "supportTypePath": "资金补助-研发专项补助-                                              ；资金补助-一次性奖励补助-                                             ",
          "contentDesc": "（一）承担非生物医药类项目企业\n资金配套标准：根据《厦门市科学技术局关于印发<关于支持企业加强研发活动加大研发投入的若干措施>的通知》（厦科规〔2026〕1号）的规定，按照企业实际获得的国拨经费（不包括转拨给其他单位的资金）给予最高50%的配套支持，其中对项目牵头企业获得的国拨经费配套比例提高至最高1:1。单个项目本市最高配套1000万元，国家和省、市资助金额之和不超过项目（课题）总投入。\n（二）承担生物医药类项目企业\n资金配套标准：根据《厦门市人民政府关于印发加快推进生物医药产业高质量发展若干措施的通知》（厦府规〔2023〕17号）的规定，对承担生物医药类国家科技重大项目（课题）的企业，按照国家实际资助1:1的比例予以配套,国家、省、市项目资助总金额不超过项目总投入。\n（三）科学城规划范围内相关单位\n资金配套标准：根据《厦门市人民政府关于印发加快推进厦门科学城建设若干措施的通知》（厦府规〔2022〕5号）的规定，对承担国家科技重大专项、重点研发计划、自然科学基金重大（重点）项目（课题）的单位，按照项目（课题）上年度实际获得国拨经费的3%奖励研发团队，单家机构每年最高不超过500万元。奖励资金按规定不受单位工资总额限制。",
          "amount": "",
          "maxAmount": "1000万元"
        }
      ],
      "structuredConditions": [
        {
          "id": "1089",
          "applicableTarget": "企业；承担非生物医药类项目企业；承担生物医药类项目企业；科学城规划范围内相关单位（企业、事业单位、社会团体或民办非企业单位）",
          "applicableTargetPath": "企业类-企业；承担非生物医药类项目企业；承担生物医药类项目企业；科学城规划范围内相关单位（企业；事业单位-高校；社会团体或民办非企业单位）",
          "applicationInstruction": "2026年03月31日-2026年04月21日",
          "applicationRequirement": "本通知所指国家科技重大项目，主要包括国家重点研发计划、国家科技重大专项（科技创新2030-重大项目、重大专项接续项目、面向2035的重大项目）、科技部攻关项目、自然科学基金重大（重点）项目（课题）等重大项目。\n（一）承担非生物医药类项目企业\n申报对象：依法登记注册，获得国家科技重大项目（课题）立项，且2025年度有实际到位国家资助资金的单位。\n（二）承担生物医药类项目企业\n申报对象：依法注册、2020年6月之后获得生物医药类国家科技重大项目（课题）立项的企业法人单位，且2025年度有实际到位国家资助资金。\n（三）科学城规划范围内相关单位\n申报对象：2021年1月1日（含）后依法注册登记且纳税地在科学城规划范围内，具备独立法人资格的企业、事业单位、社会团体或民办非企业单位等机构。",
          "applicationStartTime": "2026.03.31",
          "applicationEndTime": "2026.04.21",
          "announcementDate": ""
        }
      ],
