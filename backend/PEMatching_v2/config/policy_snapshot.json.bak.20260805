    {
      "fusionPolicyId": "6649",
      "sourcePolicyId": "24082",
      "title": "思明区新引进人才生活补贴",
      "updateTime": "2026-07-31 15:31:39.050423",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "思明区新引进人才生活补贴",
        "summary": "厦门市自2024年7月18日起实施新引进人才生活补贴政策，适用于新引进到我市企事业单位（不含参公事业）和社会组织的博士（≤40周岁）、硕士（≤35周岁）、本科及技工院校预备技师班毕业生（≤30周岁），台港澳籍和外籍人才可参照申请。申请人需具有厦门户口（台港澳及外籍除外）、经核准办理入厦人事关系，并在引进后连续缴纳社保满三个月且在岗。补贴标准为博士8万元、硕士5万元、“双一流”或世界前200名大学本科3万元、其他高校应届本科及预备技师1万元，一次性发放，不得重复申领。引进之日起一年内由所在单位申请，逾期视为放弃；2024年7月18日前引进人才按原政策执行。",
        "contactInfo": "",
        "applicationVolume": "",
        "policyAttribute": "主政策",
        "policyOriginalTitle": "中共厦门市委组织部厦门市人力资源和社会保障局厦门市财政局关于印发厦门市新引进人才生活补贴实施办法的通知",
        "sceneUsage": "人才生活补贴",
        "sceneUsagePath": "人才引进与培育-人才生活补贴",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "2024-07-18",
        "effectiveEndDate": "长期",
        "issuingDepartment": "厦门市财政局 厦门市人力资源和社会保障局 中共厦门市委组织部",
        "policyCode": "厦人社〔2024〕239号"
      },
      "supportMethods": [
        {
          "id": "1160",
          "supportType": "人才生活专项补贴",
          "supportTypePath": "人才支持-人才生活专项补贴-                                                                    ",
          "contentDesc": "按照博士每人8万元、硕士每人5万元、“双一流”建设高校（学科）及世界最新排名前200名大学本科每人3万元、其他高校应届本科及技工院校预备技师班应届毕业生每人1万元给予一次性补贴。",
          "amount": "",
          "maxAmount": "8万"
        }
      ],
      "structuredConditions": [
        {
          "id": "1158",
          "applicableTarget": "个人或团队",
          "applicableTargetPath": "个人或团队- ",
          "applicationInstruction": "长期受理",
          "applicationRequirement": "新引进的人才须同时满足以下条件：\n　　1.具有厦门户口;\n　　2.引进时已具有全日制普通高等教育本科及以上学历或经教育部认证在国（境）外取得的本科学士及以上学位（含统招非全日制研究生学历）。其中，如属于“双一流”建设高校（学科）或世界最新排名前200名大学的毕业生，毕业时其毕业院校或专业应已入选教育部公布的“双一流”建设高校（学科），或毕业时其毕业院校为世界最新排名前200名大学。2024年1月1日后毕业的技工院校预备技师班应届毕业生；\n　　3.博士不超过40周岁，硕士不超过35周岁，本科和预备技师不超过30周岁；\n　　4.经市组织、人社、教育部门核准并已办理入厦人事关系;\n　　5.已在厦就业，申请时自引进之日起缴纳社会保险费满三个月及以上且社会保险关系仍在申报单位。\n　　台港澳籍和外籍人才不受以上1和4条件限制，可参照申请。",
          "applicationStartTime": "",
          "applicationEndTime": "",
          "announcementDate": ""
        }
      ],
      "keywords": [],
      "materials": [
        {
          "id": "1158",
          "materials": "",
          "method": "（一）申请时限\n　　新引进人才原则上应自引进之日起一年内，经由所在用人单位提出申请，逾期视为放弃申请。\n（二）办理程序\n　　1.申请：新引进人才向所在用人单位提出申请。用人单位审核同意后，通过市人力资源和社会保障局（以下简称市人社局）网上服务大厅申请。\n　　2.受理：\n　　市人社局负责受理市属事业单位（不含教育系统）以及所得税缴入国家金库厦门市分库（详见企业缴税凭证中的收款国库，下同）的各类企业和社会组织的申请；\n　　市教育局负责受理市属教育系统事业单位的申请；\n　　各区人力资源和社会保障局（以下简称区人社局）或园区管委会负责受理本区（园区）属事业单位以及所得税缴入国家金库本区（园区）代理支库的各类企业和社会组织的申请。\n　　3.发放：经审核，对符合条件的人员予以公示，经公示无异议并且在职在岗的，由各受理部门发放补贴。补贴资金一次性发放至人才个人账户。",
          "url": ""
        }
      ],
