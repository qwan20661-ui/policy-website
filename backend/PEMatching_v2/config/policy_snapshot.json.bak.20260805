    {
      "fusionPolicyId": "6601",
      "sourcePolicyId": "24064",
      "title": "厦门市青年科技人员育成项目遴选",
      "updateTime": "2026-07-28 15:53:27.139335",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市青年科技人员育成项目遴选",
        "summary": "厦门市青年科技人员育成项目遴选是指对符合条件的青年科技人员进行分类评审与资助的专项工作。该项目旨在引导青年科技人员面向科技和经济社会发展需求开展研究攻关，推动人才培养和技术创新，支撑服务高质量发展。项目分A、B两类，每项资助经费3万元，重点支持新一代信息技术、高端装备、新能源、新材料、集成电路、人工智能、生物医药等领域。适用于在闽台籍青年科技人员以及高校、科研院所、企业中的青年科研人员与技术骨干。",
        "contactInfo": "1、地址：厦门市思明区虎园路2号厦门市科学技术局802室 2、电话：2021855 3、平台系统操作咨询指导及技术支持电话：0591-87882011、87862800",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市科学技术局关于开展第一批福建省青年科技人员育成项目遴选工作的通知",
        "sceneUsage": "人才专项扶持项目支持；科技计划项目支持；研发经费补助",
        "sceneUsagePath": "研发创新-人才专项扶持项目支持；研发创新-科技计划项目支持；研发创新-研发经费补助",
        "applicableScope": "福建省",
        "applicableScopePath": "省级-福建省",
        "industryField": "新能源；新材料；半导体和集成电路；生物医药",
        "industryFieldPath": "新能源；新材料；半导体和集成电路；生物医药-高端医疗器械",
        "effectiveStartDate": "2025-06-10",
        "effectiveEndDate": "2025-06-22",
        "issuingDepartment": "厦门市科学技术局"
      },
      "supportMethods": [
        {
          "id": "1142",
          "supportType": "科技发展计划项目扶持",
          "supportTypePath": "重点专项项目-科技发展计划项目扶持-                                                                                  ",
          "contentDesc": "育成项目分为A、B两类，全省共计遴选支持约400项，每项资助经费3万元。",
          "amount": "",
          "maxAmount": "3万元"
        }
      ],
      "structuredConditions": [
        {
          "id": "1140",
          "applicableTarget": "青年科技人员；在闽台籍青年科技人员；高等院校、科研院所中处于科研起步阶段的青年科技人员；企业青年技术骨干、技能型人员；高校、科研院所的技术骨干，且聘任在技能岗位的人员",
          "applicableTargetPath": "青年科技人员；在闽台籍青年科技人员；高等院校；科研院所中处于科研起步阶段的青年科技人员；企业青年技术骨干；技能型人员；事业单位-高校；科研院所的技术骨干；且聘任在技能岗位的人员",
          "applicationInstruction": "2025年06月10日-2025年06月22日",
          "applicationRequirement": "1、热爱祖国，诚实守信，具有坚实的理论或实践基础、较强的创新能力、良好的科研潜质，能独立承担研究课题。\n2、截至申报次年1月1日，申请者男性未满32周岁，女性未满35周岁。B类申请者中的技能型科技人员，年龄可以放宽3周岁。\n3、A类申请者应满足以下条件之一：具有博士学位；具有硕士学位，且有两年及以上科研工作经历。B类申请者应满足以下条件之一：具有硕士及以上学位；具有学士学位或中级工及以上职业技能等级，且有两年及以上从事技术研发工作的经历。\n4、申报人所在单位（以下简称依托单位）应为在福建省注册的法人或非法人组织，且申报人须全职在依托单位工作（人事关系在依托单位）。以企业为依托单位的，原则上应是国家高新技术企业、创新型中小企业、专精特新中小企业、专精特新“小巨人”企业、国家技术创新示范企业、制造业单项冠军企业、瞪羚企业、独角兽企业、未来独角兽企业、科技型中小企业或科技小巨人企业，同时还需是规模以上企业（软件等行业企业规模参照工业企业）或省级以上农业产业化龙头企业，申请人应是企业核心技术团队成员，是企业重点培养的科研或技术骨干。B类申请者中以高校、科研院所为依托单位的，应当是所在单位的技术骨干，且聘任在技能岗位的人员。\n5、申报人尚未承担过省级及以上科技计划项目。已入选省级及以上人才计划的不得申报。已入选福建省青年科技人员育成项目的，不得再次申报。\n6、凡被列为失信被执行人的企业及个人一律不得推荐。",
          "applicationStartTime": "2025.06.10",
          "applicationEndTime": "2025.06.22",
          "announcementDate": ""
        }
      ],
      "keywords": [
        {
          "id": "2406",
          "text": "人才专项扶持项目支持",
          "pathText": "研发创新-人才专项扶持项目支持"
        },
        {
