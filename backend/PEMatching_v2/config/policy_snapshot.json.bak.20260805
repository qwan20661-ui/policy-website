    {
      "fusionPolicyId": "6554",
      "sourcePolicyId": "24089",
      "title": "福建省技术转移机构申报",
      "updateTime": "2026-07-29 16:02:23.431983",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "福建省技术转移机构申报",
        "summary": "福建省技术转移机构申报是指对符合条件的机构进行评估、命名和管理的专项工作。申报旨在培育和发展技术转移机构，完善技术转移体系，促进科技成果转化。经评估命名后，机构可纳入省级管理体系，开展技术信息搜集、转让代理、集成开发、评估培训及投融资等服务。适用于在福建省内登记注册、具备固定场所与专职人员、无违法违规记录且经营良好的独立法人机构、内设机构或分支机构。",
        "contactInfo": "1、福建省科技成果转化中心成果评价部：0591-83782579\n2、福建省科技厅科技服务处：0591-87882425\n3、厦门市科技局科技人才与成果转化处：0592-2021575",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市科学技术局关于转发福建省科学技术厅关于2025年度省级技术转移机构申报的通知",
        "sceneUsage": "专业化技术转移服务机构认定",
        "sceneUsagePath": "资质认定-专业化技术转移服务机构认定",
        "applicableScope": "福建省",
        "applicableScopePath": "省级-福建省",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "2022.05.13",
        "effectiveEndDate": "2027.05.12",
        "issuingDepartment": "厦门市科学技术局",
        "policyCode": "闽科规〔2022〕５号"
      },
      "supportMethods": [
        {
          "id": "1167",
          "supportType": "技术经济活动奖励、一次性奖励补助",
          "supportTypePath": "资金补助-技术经济活动奖励；资金补助-一次性奖励补助-                                             ",
          "contentDesc": "1、对年技术合同认定登记额和年增长率综合排名前三的技术合同认定登记机构、命名满三年评价优秀且排名前三的交易类省级技术转移机构分别给予50万元、40万元和30万元奖励。\n",
          "amount": "",
          "maxAmount": "50万元"
        }
      ],
      "structuredConditions": [
        {
          "id": "1165",
          "applicableTarget": "技术转移机构；具有独立法人资格的机构；企事业单位的内设机构；境内外技术转移机构分支机构；高校；科研院所",
          "applicableTargetPath": "技术转移机构；具有独立法人资格的机构；企事业单位的内设机构；境内外技术转移机构分支机构；事业单位-高校；创新平台/机构类-科研院所-                                          ",
          "applicationInstruction": "2025年07月29日-2025年08月27日",
          "applicationRequirement": "1、申报的机构应是福建省内注册，具有独立法人资格的机构，或法人内设机构、分支机构（原则上一个法人只能申请一个省级技术转移机构），有固定经营场所。其中，独立法人机构需有5人（含）以上从业人员，法人内设机构或分支机构需有3人（含）以上从业人员，且有从事技术转移的人员。  \n2、申报的机构从事技术转移服务工作，为技术转移、成果转化提供服务，包括技术经纪、技术集成与经营、技术投融资服务等（单纯提供信息、法律、咨询、金融等服务的除外），具有开放的服务模式，有明确的服务对象群体。  \n3、省级技术转移机构分为交易类和平台类，交易类以促成具体的技术交易为主要目标，平台类以提供技术转移公共服务为主要任务。申报的机构应从事技术转移业务不少于两年且已有一定服务业绩，经营状况良好。申报交易类的机构，2023－2024年促成技术交易总金额不低于400万元；申报平台类的机构，2023－2024年主办、承办或协办技术转移活动不少于10场次且不少于500人次参与活动，服务企业数不少于100家。  \n4、以高校、科研院所等非企业单位内设机构、分支机构作为申报机构的，应具备开展技术转移工作的条件和职能，制定技术转移管理、运营和分配制度。  \n5、以企业作为申报机构的，应具备适合自身发展要求的商业模式及从业经验，制定技术转移服务的章程、服务规范、内部管理制度和员工奖惩机制。  \n6、被取消资格的省级技术转移机构，两年内不纳入申报对象范围。",
          "applicationStartTime": "2025.07.29",
          "applicationEndTime": "2025.08.27",
          "announcementDate": ""
        }
      ],
      "keywords": [
        {
          "id": "2508",
          "text": "专业化技术转移服务机构认定",
          "pathText": "资质认定-平台资质认定-专业化技术转移服务机构认定"
        }
      ],
      "materials": [
        {
          "id": "1165",
          "materials": "1、《福建省技术转移机构申报书》\n2、附件材料\n3、“申报单位承诺函”（经申报单位负责人签字并加盖公章后扫描生成PDF格式文件）",
          "method": "1、申报单位登录福建省科技创新平台及机构管理系统（http://xmgl.kjt.fujian.gov.cn）,在线填写申报材料并提交推荐单位。流程为：申报单位注册并登录福建省科技创新平台及机构管理系统-申报受理-选择技术转移服务机构-申报指南-添加-申报项目-填写《福建省技术转移机构申报书》，并按要求上传附件材料。\n2、申报无需报送纸质材料，需在申报系统内在线打印“申报单位承诺函”，经申报单位负责人签字并加盖公章后扫描生成PDF格式文件，上传至申报系统的附件栏书附件相关栏。",
          "url": "http://xmgl.kjt.fujian.gov.cn"
        }
      ],
