    {
      "fusionPolicyId": "6564",
      "sourcePolicyId": "24081",
      "title": "思明区国家级高新技术企业认定奖励申报",
      "updateTime": "2026-07-30 16:45:52.174129",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "思明区国家级高新技术企业认定奖励申报",
        "summary": "思明区国家级高新技术企业认定奖励申报是指对依法设立在思明区且经认定批准的国家级高新技术企业进行区级配套奖励的专项工作。",
        "contactInfo": "1、联系电话：0592-2667991，15160086520\n2、技术咨询：17759986960",
