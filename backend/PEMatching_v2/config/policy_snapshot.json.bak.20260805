      "title": "思明区创新型中小企业评价",
      "updateTime": "2026-07-31 15:02:16.720450",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "思明区创新型中小企业评价",
        "summary": "创新型中小企业评价是指对符合评价标准、创新能力强且成长性好的独立法人中小企业进行评价入库的专项工作。该评价旨在提升中小企业创新能力和专业化水平，促进中小企业高质量发展。经评价入库的企业可享受全周期、多层次的培育扶持服务，并作为申报专精特新中小企业等更高层次认定的基础，适用于在厦门市依法登记注册且正常开展经营活动的中小企业。",
        "contactInfo": "1、思明区工信局：5885927、2058997\n2、湖里区工信局：5722172、5939171\n3、集美区工信局：6220363、6219135\n4、海沧区工信局：6057579\n5、同安区工信局：7010102\n6、翔安区工信局：7882763、7886536\n7、火炬管委会：5382025、5707557\n8、厦门市中小企业服务中心：2233621、2211821\n9、厦门市工业和信息化局：2896792",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市工业和信息化局关于组织开展2025年创新型中小企业评价工作的通知",
        "sceneUsage": "创新型中小企业认定",
        "sceneUsagePath": "资质认定-创新型中小企业认定",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "2023-02-01",
        "effectiveEndDate": "2025.12.31",
        "issuingDepartment": "厦门市工业和信息化局",
        "policyCode": "厦工信规〔2023〕2号"
      },
      "supportMethods": [
        {
          "id": "1158",
          "supportType": "专精特新企业认定",
          "supportTypePath": "资质荣誉-专精特新企业认定-                                                                             ",
          "contentDesc": "着力构建政府公共服务、市场化服务、公益性服务协同促进的服务体系，通过搭建创新成果对接、产融对接、大中小企业融通创新、创新创业大赛、供需对接、管理培训等平台，汇聚服务资源，创新服务方式，为中小企业提供全周期、全方位、多层次的服务。组织推荐优质中小企业参加中博会、APEC中小企业技展会等专业展会，开拓国内外市场。",
          "amount": "",
          "maxAmount": ""
        }
      ],
      "structuredConditions": [
        {
          "id": "1156",
          "applicableTarget": "创新型中小企业；专精特新中小企业；成长型中小企业；企业类；事业单位",
          "applicableTargetPath": "企业类-创新型中小企业-        ；企业类-专精特新中小企业-                       ；成长型中小企业；企业类-国家级专精特新“小巨人”企业-      ；事业单位-高校",
          "applicationInstruction": "当前政策申报已过期，敬请及时关注有关部门最新消息",
          "applicationRequirement": "（一）应具有独立法人资格，正常开展经营活动，符合《中小企业划型标准规定》（工信部联企业[2011]300号）的企业；\n（二）企业未被列入经营异常名录或严重失信主体名单，提供的产品（服务）不属于国家禁止、限制或淘汰类，同时近三年未发生重大安全（含网络安全、数据安全）、质量、环境污染等事故以及偷漏税等违法违规行为；\n（三）坚持企业自愿原则，按照申报评价标准（详见附件2），评价得分达到60分以上（其中创新能力指标得分不低于20分、成长性指标及专业化指标得分均不低于15分），或满足下列创新直通条件之一：\n1.近三年内获得过国家级、省级科技奖励；\n2.获得高新技术企业、国家级技术创新示范企业、知识产权优势企业和知识产权示范企业等荣誉（均为有效期内）；\n3.拥有经认定的省部级以上研发机构；\n4.近三年新增股权融资总额（合格机构投资者的实缴额）500万元以上。\n备注：有效期内的专精特新中小企业、专精特新“小巨人”企业无需参与创新型中小企业评价。",
          "applicationStartTime": "2025-03-31",
          "applicationEndTime": "2025-11-30",
          "announcementDate": ""
        }
      ],
      "keywords": [
        {
          "id": "2552",
          "text": "创新型中小企业认定",
          "pathText": "资质认定-企业资质认定-创新型中小企业认定"
        },
        {
          "id": "2553",
          "text": "专精特新中小企业认定",
          "pathText": "资质认定-企业资质认定-专精特新中小企业认定"
