    {
      "fusionPolicyId": "6491",
      "sourcePolicyId": "24100",
      "title": "福建省高校产学合作项目申报",
      "updateTime": "2026-07-29 09:59:59.860589",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "福建省高校产学合作项目申报",
        "summary": "福建省高校产学合作项目申报指南是指针对省内高校与合作企业联合开展技术研发和成果转化项目制定的专项申报指引。旨在推动军民融合科技创新，对接区域经济与产业发展关键技术需求。重点支持工业、农业及社会发展领域的联合攻关，涵盖新一代信息技术、人工智能、种业创新、人口健康等核心技术研发。适用于具备推荐权限的省内高校与在闽注册企业合作申报，单个项目资助额度不超过50万元，实施期限为2至3年。",
        "contactInfo": "",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "2026年度高校产学合作项目申报指南",
        "sceneUsage": "产学研合作项目支持",
        "sceneUsagePath": "研发创新-产学研合作项目支持",
        "applicableScope": "福建省",
        "applicableScopePath": "省级-福建省",
        "industryField": "新材料；电力装备；生物医药",
        "industryFieldPath": "新材料；电力装备；生物医药-高端医疗器械",
        "effectiveStartDate": "2025-11-10",
        "effectiveEndDate": "长期",
        "issuingDepartment": "福建省科学技术厅",
        "policyCode": "闽科资〔2025〕7号"
      },
      "supportMethods": [
        {
          "id": "1178",
          "supportType": "研发专项补助",
          "supportTypePath": "资金补助-研发专项补助-                                              ",
          "contentDesc": "（五）申请项目资助经费预算应合理、科学，单个项目申请资助额度不超过50万元。",
          "amount": "",
          "maxAmount": "50万元"
        }
      ],
      "structuredConditions": [
        {
          "id": "1176",
          "applicableTarget": "省内高校；合作企业；高校科技人员（项目负责人）",
          "applicableTargetPath": "省内高校；合作企业；高校科技人员（项目负责人）",
          "applicationInstruction": "长期受理",
          "applicationRequirement": "（一）基础研究和应用基础研究项目不在本批支持范围内。\n（二）项目应以有推荐权限的省内高校二级学院或系作为项目申请单位与合作企业（第一合作单位）联合申报，无推荐权限的高校应以独立法人作为申请单位；合作企业应是在闽注册、具有独立法人资格并具有一定规模的企业或市级以上农业产业化龙头企业。高校、合作企业及项目负责人应签订三方合作协议（格式下载网址：http://xmgl.kjt.fujian.gov.cn/）。\n（三）高校科技人员作为项目负责人应是省内高校在编并实际主持研究工作的科技人员，在项目结束时年龄原则上不超过延迟退休后的法定退休年龄，同期主持和申请的省科技计划项目数原则上不超过1项（含省科技重大专项的专题项目、区域发展项目、高校产学合作项目、对外合作项目、星火项目、引导性项目、创新战略研究项目、科技型中小企业技术创新资金项目、自然科学基金项目、公益类科研院所基本科研项目、科技创新平台建设项目、成果转化项目、院省合作项目、协同创新平台项目、原STS项目以及中央引导地方项目等）。\n（四）高校、设区市管理部门对推荐的项目均应到合作企业现场进行调研核实，重点审核是否真实开展产学合作，项目研究成果是否能够落地转化。\n（五）申请项目资助经费预算应合理、科学，单个项目申请资助额度不超过50万元。\n（六）项目实施期限为2-3年，申报项目研发起始时间为2026年5月1日，结束时间一般不超过2029年4月30日。",
          "applicationStartTime": "2026-05-01",
          "applicationEndTime": "2029-04-30",
          "announcementDate": ""
        }
      ],
      "keywords": [
        {
          "id": "2498",
          "text": "产学研合作项目支持",
          "pathText": "研发创新-产学研合作项目支持"
        }
      ],
      "materials": [
        {
          "id": "1176",
          "materials": "各高校、设区市科技管理部门应按照申报通知要求，指导和组织项目申请单位的科技人员通过福建省科技计划项目管理信息系统网上填报《福建省科技计划项目申请书》，编写可行性研究报告作为申请书附件。\n网上申报流程为：申报单位注册登录福建省科技计划项目管理信息系统(http://xmgl.kjt.fujian.gov.cn )─申报管理─添加项目申请书─选择“高校产学合作项目”及对应指南代码 ─填报申请书─上传附件（可行性研究报告、合作协议等）。\n各高校通过省级项目推荐流程进行内部审核，上传项目现场调研核实意见表（格式下载网址：http://xmgl.kjt.fujian.gov.cn/）、推荐函、项目汇总表（格式下载网址：http://xmgl.kjt.fujian.gov.cn），负责归口对申报材料进行网上推荐。如没有及时将以上材料上传的，需按照工业、农业、社发领域将推荐函、项目汇总表、项目现场调研核实意见表各一式1份分别寄送我厅高新处、农村处和社发处，逾期不再受理（项目申请书及相关附件纸质材料不需报送）。",
          "method": "网上申报流程为：申报单位注册登录福建省科技计划项目管理信息系统(http://xmgl.kjt.fujian.gov.cn )─申报管理─添加项目申请书─选择“高校产学合作项目”及对应指南代码 ─填报申请书─上传附件（可行性研究报告、合作协议等）。\n各高校通过省级项目推荐流程进行内部审核，上传项目现场调研核实意见表（格式下载网址：http://xmgl.kjt.fujian.gov.cn/）、推荐函、项目汇总表（格式下载网址：http://xmgl.kjt.fujian.gov.cn），负责归口对申报材料进行网上推荐。如没有及时将以上材料上传的，需按照工业、农业、社发领域将推荐函、项目汇总表、项目现场调研核实意见表各一式1份分别寄送我厅高新处、农村处和社发处，逾期不再受理（项目申请书及相关附件纸质材料不需报送）。",
          "url": "http://xmgl.kjt.fujian.gov.cn/"
        }
      ],
