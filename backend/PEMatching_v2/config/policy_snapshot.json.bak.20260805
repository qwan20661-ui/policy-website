    {
      "fusionPolicyId": "6541",
      "sourcePolicyId": "24008",
      "title": "厦门市医工结合项目申报",
      "updateTime": "2026-07-28 09:18:49.154452",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市医工结合项目申报",
        "summary": "厦门市医工结合项目申报是指医疗机构牵头联合企业共同开展医工交叉研究，旨在推动医疗与工程技术深度融合，加速创新成果转化应用的专项工作。项目分为指导性与资助性两类，资助项目经评审择优立项，每项最高获10万元经费资助，需配套不低于1:1的自筹经费。该工作适用于厦门市医疗机构及具备研发能力的企业，重点支持新优药械产品迭代升级与临床评价合作，通过明确权责与成果归属促进产学研医协同创新。",
        "contactInfo": "1、kjj_zrz@xm.gov.cn；2、厦门市思明区虎园路2号市科技信息研究院508室；3、叶维汝 0592-2050966；4、0292-5397711；5、0592-2021860",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市科学技术局关于开展2026年度厦门市医工结合项目申报工作的通知",
        "sceneUsage": "医工交叉融合创新项目支持",
        "sceneUsagePath": "研发创新-医工交叉融合创新项目支持",
