    {
      "fusionPolicyId": "6597",
      "sourcePolicyId": "24006",
      "title": "厦门市创新积分制企业信息填报",
      "updateTime": "2026-08-03 11:30:37.106052",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市创新积分制企业信息填报",
        "summary": "厦门市创新积分制企业信息填报是指高新技术企业及具备独立法人资格、有研发经费投入和研发活动的科技型企业，通过指定渠道填报企业经营、创新及贷款需求等信息的专项工作。该工作旨在通过科技部计算企业创新积分，为符合条件的企业争取中国人民银行组织商业银行提供的低利率授信支持，并作为后续享受各类科技金融扶持政策与应用场景的重要基础，适用于在厦门市注册的相关科技企业。",
        "contactInfo": "咨询电话：2025955、2052826、2052621 责任处室：市科技局科技资源配置处",
        "applicationVolume": "",
        "policyAttribute": "申报通知",
        "policyOriginalTitle": "厦门市科学技术局关于开展2025年“创新积分制”企业信息填报工作的通知",
        "sceneUsage": "科技信贷专项产品",
        "sceneUsagePath": "科技金融-科技信贷专项产品",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "",
        "effectiveEndDate": ""
      },
      "supportMethods": [
        {
          "id": "1084",
          "supportType": "",
          "supportTypePath": "",
          "contentDesc": "1、通过向金融机构提供低成本资金,引导金融机构积极向科技型企业提供优惠的贷款条件,扩大贷款规模，促进科技创新和产业升级。\n2、科技部将根据企业数据计算企业创新积分，对满足条件的相关企业，中国人民银行会尽快组织商业银行提供低利率授信。\n3、后续还将依托创新积分陆续推出新的应用场景和扶持措施。",
          "amount": "",
          "maxAmount": ""
        }
      ],
      "structuredConditions": [
        {
          "id": "1082",
          "applicableTarget": "高新技术企业；企业类",
          "applicableTargetPath": "企业类-高新技术企业；企业类-国家级专精特新“小巨人”企业-      ",
          "applicationInstruction": "2025年05月20日-2025年07月05日",
          "applicationRequirement": "1、高新技术企业及在我市注册且具备独立法人资格，有研发经费投入和研发活动的科技型企业。",
          "applicationStartTime": "2025.05.20",
          "applicationEndTime": "2025.07.05",
          "announcementDate": ""
        }
      ],
      "keywords": [
