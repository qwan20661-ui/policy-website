    {
      "fusionPolicyId": "6569",
      "sourcePolicyId": "16644",
      "title": "集美区国家级高新技术企业、科技进步奖扶持",
      "updateTime": "2026-07-30 18:01:59.539385",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "集美区国家级高新技术企业、科技进步奖扶持",
        "summary": "国家级高新技术企业、科技进步奖扶持政策是指集美区对符合条件的国家级高新技术企业及获得科学技术进步奖的企业给予资金奖励的专项扶持举措。该举措对首次认定及重新认定通过的高新技术企业给予10万至30万元奖励，对获得国家或省市级科技进步奖的成果团队给予3万至50万元一次性补助。适用于商事登记地与纳税均归属集美区的独立法人企业。",
        "contactInfo": "业务咨询电话：6225636、6157810；网上填报技术咨询电话：5707072",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市集美区科技和工信局关于开展2024年国家级高新技术企业、科技进步奖扶持政策申报的通知_厦门市集美区人民政府门户网站",
        "sceneUsage": "",
        "sceneUsagePath": "",
        "applicableScope": "集美区",
        "applicableScopePath": "集美区",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "2022-01-01",
        "effectiveEndDate": "2023-12-31",
        "issuingDepartment": "厦门市集美区科技和工信局",
        "policyCode": "厦集工信规〔2022〕6号"
      },
      "supportMethods": [
        {
          "id": "665",
          "supportType": "一次性奖励补助",
          "supportTypePath": "资金补助-一次性奖励补助-                                             ",
          "contentDesc": "1.首次认定及重新认定通过的国家级高新技术企业给予10万元奖励。对于上年度营收2000万元及以上的规模以上企业，首次通过国家级高新技术企业认定，叠加后给予30万元奖励；通过重新认定，叠加后给予20万元奖励。\n2.集美区企业人才当年度获得国家科学技术进步特等奖、一、 二等奖的，分别一次性给予成果完成团队50 万元、20 万元、10 万元的奖励。获得省市级科学技术进步一、二、三等奖的，分别一次性给予成果完成团队 10 万元、5 万元、3 万元的奖励。",
          "amount": "1、首次认定及重新认定通过的国家级高新技术企业：给予10万元奖励\n2、上年度营收2000万元及以上的规模以上企业首次通过国家级高新技术企业认定：叠加后给予30万元奖励\n3、上年度营收2000万元及以上的规模以上企业通过重新认定：叠加后给予20万元奖励\n4、集美区企业人才当年度获得国家科学技术进步特等奖：一次性给予成果完成团队50万元的奖励\n5、集美区企业人才当年度获得国家科学技术进步一等奖：一次性给予成果完成团队20万元的奖励\n6、集美区企业人才当年度获得国家科学技术进步二等奖：一次性给予成果完成团队10万元的奖励\n7、获得省市级科学技术进步一等奖：一次性给予成果完成团队10万元的奖励\n8、获得省市级科学技术进步二等奖：一次性给予成果完成团队5万元的奖励\n9、获得省市级科学技术进步三等奖：一次性给予成果完成团队3万元的奖励",
          "maxAmount": "50万元"
        }
      ],
      "structuredConditions": [
        {
          "id": "663",
          "applicableTarget": "企业",
          "applicableTargetPath": "企业类-企业",
          "applicationInstruction": "2024年11月22日-2024年11月29日",
          "applicationRequirement": "1、企业须具备独立法人资格，商事登记地、纳税（入库为准）均归属集美区，无严重违规行为，且符合以下任一条件：\n（1）2023年1月1日起至2023年12月31日止经认定或批复的国家级高新技术企业；\n（2）2023年1月1日起至2023年12月31日止获得科学技术进步奖的企业（以批文时间为准）；\n2、企业已获得厦门市其他区（含火炬高新区、自贸区）同类区级奖励的，不得重复申请。",
          "applicationStartTime": "2024.11.22",
          "applicationEndTime": "2024.11.29",
          "announcementDate": ""
        }
      ],
