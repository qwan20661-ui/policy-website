    {
      "fusionPolicyId": "6460",
      "sourcePolicyId": "24039",
      "title": "厦门市科学技术奖提名",
      "updateTime": "2026-07-29 16:57:26.092134",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市科学技术奖提名",
        "summary": "厦门市科学技术奖提名是指对在本市科学技术进步活动中做出突出贡献的个人和组织进行评选表彰的专项工作。提名涵盖重大贡献奖、杰出人才奖、自然科学奖、技术发明奖、科技进步奖、成果转化奖及国际科技合作奖等类别。该机制通过实行规范提名制、发放高额奖金与荣誉证书，旨在全面激发科技人员创新活力，促进高水平科技成果产出与高效转化，推动基础研究、关键核心技术突破及国际科技合作，服务国家战略与厦门经济社会高质量发展。",
        "contactInfo": "1、联系人：陈蔓莉 2、联系电话：0592-5380722 3、电子邮箱：hj_cxcyc@xm.gov.cn 4、纸质材料寄送地址：厦门市湖里区火炬路56-58号火炬广场南楼815室 5、厦门市科学技术局联系电话：0592-2051278",
        "applicationVolume": "",
        "policyAttribute": "申报通知",
        "policyOriginalTitle": "厦门市科学技术奖励委员会办公室关于开展2025年度厦门市科学技术奖提名工作的通知",
        "sceneUsage": "科学技术奖",
        "sceneUsagePath": "研发创新-科技创新奖励-科学技术奖",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "2025.11.29",
        "effectiveEndDate": "2030.11.28",
        "issuingDepartment": "厦门市科学技术奖励委员会办公室"
      },
      "supportMethods": [
        {
          "id": "1117",
          "supportType": "",
          "supportTypePath": "",
          "contentDesc": "第二十四条 市科学技术奖颁发证书、奖金。\n市科学技术重大贡献奖奖金每人100万元，市科技创新杰出人才奖奖金每人25万元，市国际科学技术合作奖奖金每项30万元，市自然科学奖、市技术发明奖、市科学技术进步奖、市科学技术成果转化奖奖金每项分别为一等奖50万元、二等奖20万元、三等奖10万元。\n市科学技术奖的奖金和工作经费纳入财政年度预算，从市科技发展经费列支。\n市科学技术重大贡献奖、市科技创新杰出人才奖的奖励荣誉和奖金由获奖人个人享有；市自然科学奖、市技术发明奖、市科学技术进步奖、市科学技术成果转化奖、市国际科学技术合作奖的奖励荣誉由项目成果完成单位和完成人共享，奖金由完成人按贡献大小自主协商分配。",
          "amount": "",
          "maxAmount": "100万元"
        }
      ],
      "structuredConditions": [
        {
          "id": "1115",
          "applicableTarget": "个人；组织；企业；高校科研院所",
          "applicableTargetPath": "个人；组织；企业类-企业；高校科研院所",
          "applicationInstruction": "2025年12月29日-2026年01月22日",
          "applicationRequirement": "被提名项目必须符合《厦门市科学技术奖励办法》规定的奖励范围和条件。凡涉及国防、国家安全及由于国家安全、保密等原因不能公开的项目，不属于市科学技术奖评奖范围。\n　　（一）市科学技术重大贡献奖\n　　市科学技术重大贡献奖授予在科学研究、技术创新、科学技术成果转化和高新技术产业化等方面取得重大成就或获得自主知识产权，符合下列条件之一的个人：\n　　1.在科学技术创新、科学技术成果转化和高新技术产业化中，取得重大经济和社会效益的；\n　　2.在引进先进设备进行消化、吸收和原材料国产化过程中，有明显改进或创新，并取得重大效益的；\n　　3.在国家安全、医疗卫生、城市建设、重大工程、环境保护、社会保障等社会事业的科学研究中有重大突破并取得显著社会效益或经济效益的。\n　　原则上应获得过省、市科学技术奖一等奖或国家科学技术奖励。\n　　（二）市科技创新杰出人才奖\n　　市科技创新杰出人才奖授予在科学发现、技术发明、技术创新、科技成果转化、利用高新技术改造传统产业和高新技术产业化中取得重要创新成就并创造较大经济或社会效益，符合下列条件之一的个人：\n　　1.国家自然科学奖、技术发明奖、科学技术进步奖二等奖（含）以上项目的主要完成人；\n　　2.中国专利金奖、银奖或中国专利优秀奖项目的主要完成人；\n　　3.省自然科学奖、技术发明奖、科学技术进步奖二等奖（含）以上或市科学技术进步一等奖以上项目的主要完成人；\n　　4.省专利奖二等奖（含）以上项目的主要完成人；\n　　5.其他对促进本市科技进步、科技成果转化做出突出贡献的人才。\n　　已获得市科学技术重大贡献奖的，除自获奖以来又做出满足前款规定条件的新贡献、新成就外，原则上不再提名市科技创新杰出人才奖。\n　　（三）市科学技术进步奖\n　　市科学技术进步奖授予在研究开发、技术创新、技术发明、应用推广先进科学技术成果，解决技术难题、完成重大科学技术工程项目等方面，做出突出成就或取得自主知识产权，符合以下条件之一的组织或个人：\n　　1.技术发明项目\n　　运用科学技术知识在产品、工艺、材料及其系统等方面进行研究开发，形成技术发明，并同时具备下列条件：\n　　（1）前人尚未发明、发现或者公开；\n　　（2）具有先进性和创新性；\n　　（3）项目实施后，取得了显著经济效益、社会效益或生态环境效益。\n　　2.技术开发、社会公益与重大工程项目\n　　在应用推广先进科学技术成果，完成重大科学技术工程项目等方面，具备下列条件之一：\n　　（1）在实施技术开发项目中，完成重大科学技术创新、科学技术成果转化，对我市科技、经济发展有重要推动作用，并取得显著经济效益；\n　　（2）在实施社会公益项目中，有科学技术创新，并取得重大科技成果，经过实践检验，创造了显著社会效益；\n　　（3）在实施重大工程项目中，采用先进技术，完成集成创新，确保工程达到国内先进以上水平。\n　　项目应当是在本市辖区内研究开发、转化推广以及与国内外合作研究开发的科技成果。项目第一完成单位为在厦注册的单位，第一完成人的主要工作应在本市内完成。其整体技术必须在2024年5月31日前已开始应用（其中重大工程类项目必须为2024年5月31日前已通过验收），食品药品类项目，须取得政府相关监管部门的批准号并在市场或医疗机构正式销售使用两年以上（2023年5月31日前）。\n　　项目须办理科技成果登记手续并取得市科技成果登记号",
          "applicationStartTime": "2025.12.29",
          "applicationEndTime": "2026.01.22",
          "announcementDate": ""
        }
      ],
