    {
      "fusionPolicyId": "6472",
      "sourcePolicyId": "24054",
      "title": "厦门市自然科学基金项目申报",
      "updateTime": "2026-08-03 11:05:43.322481",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市自然科学基金项目申报",
        "summary": "厦门市自然科学基金项目申报是指厦门市为规范和加强市级科技计划管理，面向符合条件的科研机构与科研人员开展基础和应用基础研究项目立项的专项工作。旨在资助和引导科研人员特别是青年人才开展前瞻性研究，提升科技源头供给能力。获批项目实行经费包干制，面上项目资助8万元，青年项目资助5万元，并为优秀青年博士提供免评审支持，适用于依法注册的高等院校、科研院所及其他公益性机构。",
        "contactInfo": "1、业务咨询：2035277\n2、材料形式审核咨询：2050966\n3、网上填报技术问题咨询：5397711\n4、推荐汇总表发送邮箱：kjj_hhy@xm.gov.cn\n5、业务处室：市科技局创新体系与政策法规处\n6、咨询电话：0592-2035277",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市科学技术局关于发布2026年度厦门市自然科学基金项目（中央引导地方科技发展资金项目）申报指南的通知",
        "sceneUsage": "基础研究专项支持；科技计划项目支持",
        "sceneUsagePath": "研发创新-基础研究专项支持；研发创新-科技计划项目支持",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "通用行业",
        "industryFieldPath": "通用行业",
        "effectiveStartDate": "2025.10.26",
        "effectiveEndDate": "2030.10.25",
        "issuingDepartment": "厦门市科学技术局",
        "policyCode": "厦科规〔2025〕5号"
      },
      "supportMethods": [
        {
          "id": "1132",
          "supportType": "研发专项补助",
          "supportTypePath": "资金补助-研发专项补助-                                              ",
          "contentDesc": "设置自然基金面上项目、自然基金青年项目、自然基金联合资助项目，所有项目纳入统一管理，资助方式及资助金额标准如下：\n　　（一）面上项目：市财政资金定额资助，每项8万元。\n　　（二）青年项目：市财政资金定额资助，每项5万元。\n　　为加快培育青年科学家和青年科技人才，在厦门市自然科学基金项目申报中针对35周岁以下、在厦加入研发机构的优秀博士开展“免评审”直接给予青年项目支持。\n　　（三）联合项目：根据评审情况，在未获面上项目、青年项目立项且专家评分60分（含）以上的项目中择优结转，由申报单位自筹解决项目研究经费。\n　　在获得立项支持的青年项目和面上项目中，部分从中央引导地方科技发展资金安排项目资助资金。",
          "amount": "",
          "maxAmount": "8万元"
        }
      ],
      "structuredConditions": [
        {
          "id": "1130",
          "applicableTarget": "个人或团队",
          "applicableTargetPath": "个人或团队- ",
          "applicationInstruction": "2025年12月22日-2026年02月02日",
          "applicationRequirement": "申报对象**\n　　依法注册、具有基础研究和应用基础研究能力和条件的、已纳入国家科技部科技活动统计调查且研究内容符合单位主营业务的在厦高等院校、科研院所、厦门市重点培育研发机构或重大新型研发机构、国家（全国）重点实验室、福建省创新实验室和上一轮评估良好（含）以上的厦门市重点实验室（高校、科研院所）的科研人员。\n\n项目申请人（即项目负责人）应为项目单位全职科研人员（不含博士后、退休返聘人员），每个申请人当年限申报一项市自然基金项目，所申报项目应符合年度申报指南要求。项目申请人应同时具备下列条件：\n　　（一）具有硕士及以上学位或高级职称，且申请人法定退休时间不得早于项目实施结束时间。\n　　（二）项目申请人无在研的国家、福建省、厦门市自然科学基金项目；市级在研项目不超过2项；不存在用相同或内容相近的项目重复或多头申报。\n　　（三）青年项目的申请人，截至申请当年1月1日，男性不超过35周岁（1991年1月1日后出生），女性不超过38周岁（1988年1月1日后出生），已作为负责人承担过市自然科学基金青年项目的不得再次申报该类项目。\n　　（四）“免评审”青年项目申请人除满足上述第（二）（三）点要求之外，需获得博士学位，且博士学位授予单位满足以下条件之一：\n　　1.境内博士学位授予单位，学科专业入选国家“一流建设学科”（第一轮或第二轮均可），且在全国第四轮学科评估中等次达“B+”以上（含）。\n　　2.境外或我国港澳台地区博士学位授予单位，在下列世界大学排行榜之一（以已发布的最新版为准）排名进入前一百。\n　　（1）上海交通大学世界一流大学研究中心发布的世界大学学术排名（ARWU）；\n　　（2）国际高等教育研究机构Quacquarelli Symonds发布的QS世界大学排名；\n　　（3）《泰晤士高等教育》发布的世界大学排名。\n　　（五）申报“免评审”青年项目未满足免评审条件的，统一纳入评审。且博士学位授予单位满足以下条件之一：1.境内博士学位授予单位，学科专业入选国家“一流建设学科”（第一轮或第二轮均可），且在全国第四轮学科评估中等次达“B+”以上（含）。2.境外或我国港澳台地区博士学位授予单位，在下列世界大学排行榜之一（以已发布的最新版为准）排名进入前一百。（1）上海交通大学世界一流大学研究中心发布的世界大学学术排名（ARWU）；（2）国际高等教育研究机构Quacquarelli Symonds发布的QS世界大学排名；（3）《泰晤士高等教育》发布的世界大学排名。",
          "applicationStartTime": "2025.12.22",
          "applicationEndTime": "2026.02.02",
          "announcementDate": ""
        }
      ],
