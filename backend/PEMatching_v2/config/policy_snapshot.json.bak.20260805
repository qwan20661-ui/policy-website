    {
      "fusionPolicyId": "6532",
      "sourcePolicyId": "24059",
      "title": "厦门市重点企业骨干人才子女就读厦门高新学校需求申报",
      "updateTime": "2026-07-28 09:26:31.492630",
      "status": "ACTIVE",
      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市重点企业骨干人才子女就读厦门高新学校需求申报",
        "summary": "厦门市高新技术企业人才服务是指为厦门市国家级高新技术企业、技术先进型服务企业和未来产业骨干企业的人才提供子女就读厦门高新学校的专项支持服务。符合条件的企业中层、高管及技术骨干人才可通过市科技局或各区部门推荐申报，经审核通过后子女可入读厦门高新学校，切实解决重点企业骨干人才子女入学问题，优化人才发展环境。",
        "contactInfo": "1、咨询受理：厦门市高新技术发展协会；\n2、咨询电话：2025913、2052826；\n3、责任处室：市科技局前沿技术与产业科技处；\n4、电话：2661606。\n5、联系人：小陈；\n6、联系电话：2668009。",
        "applicationVolume": "",
        "policyAttribute": "指导政策",
        "policyOriginalTitle": "厦门市科学技术局关于转发《厦门高新学校2025年秋季招生通告》的通知",
        "sceneUsage": "",
        "sceneUsagePath": "",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "未来产业",
        "industryFieldPath": "未来产业-深海空天开发",
        "effectiveStartDate": "",
        "effectiveEndDate": "",
        "issuingDepartment": "厦门市科学技术局"
      },
      "supportMethods": [
        {
          "id": "1137",
          "supportType": "高层次人才子女入学保障",
          "supportTypePath": "人才支持-高层次人才子女入学保障-                                                                        ",
          "contentDesc": "",
          "amount": "",
          "maxAmount": ""
        }
      ],
      "structuredConditions": [
        {
          "id": "1135",
          "applicableTarget": "重点企业骨干人才；符合条件的企业；用人单位；国家级高新技术企业；技术先进型服务企业；未来产业骨干企业；人才",
          "applicableTargetPath": "重点企业骨干人才；符合条件的企业；用人单位；国家级高新技术企业；技术先进型服务企业；企业类-未来产业骨干企业-                         ；人才",
          "applicationInstruction": "2026年05月21日-2026年06月08日",
          "applicationRequirement": "1、全市规模以上的国家级高新技术企业、技术先进型服务企业和未来产业骨干企业的中层、高管及技术骨干人才子女",
          "applicationStartTime": "2026.05.21",
          "applicationEndTime": "2026.06.08",
          "announcementDate": ""
        }
      ],
      "keywords": [],
      "materials": [
        {
          "id": "1135",
          "materials": "1、《2025年厦门市国家级高新技术企业、技术先进型服务企业和未来产业骨干企业人才子女就学需求申报汇总表》（加盖公章，企业负责人签字）；\n2、人才近12个月个人所得税纳税清单；\n3、人才近12个月在厦连续缴交社保证明；\n4、人才岗位佐证材料（如：劳动合同、任职文件等）；\n5、人才及子女的身份证件（或护照、台胞证）的复印件；申请一年级入学需提供出生医学证明复印件；申请七年级入学需提供原学校盖章的六年级上学期素质报告单复印件；\n6、电子版材料（材料1的Excel表和1-5的扫描PDF）。\n7、《2025年重点企业骨干人才子女就学需求申报汇总表》（加盖公章，企业负责人签字）；\n8、近12个月的薪酬收入证明；\n9、岗位佐证材料（如：劳动合同、任职文件）；\n10、人才及子女的身份证件（或护照、台胞证）的复印件；申请一年级入学需提供出生医学证明复印件，申请七年级入学需提供原学校盖章的六年级上学期素质报告单复印件。\n11、人才近12个月在厦连续缴交社保证明。\n12、电子版材料（全套材料扫描为PDF格式和“2024重点企业骨干人才子女就学需求申报汇总表EXCEL格式”）。",
          "method": "1、符合条件的企业将申报材料（纸质材料和电子版）提交至厦门市高新技术发展协会（厦门市虎园路2号科技大院5号楼609、612室）进行初审，材料齐全后报送至市科技局前沿处。\n2、预申报七年级入学需求截止时间：2025年5月23日下午16:00；\n3、预申报一年级入学需求截止时间：2025年6月8日下午16:00。\n4、符合条件的企业向思明区科工局进行申报，火炬企业可向火炬管委会申报。\n5、申报七年级入学需求截止时间为2025年5月22日，申报一年级入学需求截止时间为2025年6月6日，逾期不再受理。\n6、纸质材料提交至禾祥东路168号思明区社会事务服务中心1413。\n7、电子版发送至邮箱1461927146@qq.com。",
          "url": ""
        }
      ],
