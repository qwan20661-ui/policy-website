      "reviewStatus": "1",
      "policyInfo": {
        "policyTitle": "厦门市科技专家库专家征集",
        "summary": "厦门市科技专家库专家征集是指面向高校、科研机构、企事业单位等组织，公开遴选符合专业条件与信用要求的专业技术人员并纳入市级专家库管理的专项工作。入库的技术、管理、财经及金融专家将通过随机抽取或邀请方式参与厦门市科技评价、咨询与评估活动。该工作旨在保障科技管理活动的科学性、合理性与公正性，规范专家选取与使用，适用于具备相应资质、熟悉行业创新动向且能独立客观开展评审咨询工作的科技工作者。",
        "contactInfo": "咨询电话：2021925、2022858；技术支持电话：5397711",
        "applicationVolume": "",
        "policyAttribute": "申报通知",
        "policyOriginalTitle": "厦门市科学技术局关于继续征集厦门市科技专家库专家的通知",
        "sceneUsage": "",
        "sceneUsagePath": "",
        "applicableScope": "厦门市",
        "applicableScopePath": "市级-厦门市",
        "industryField": "通用行业",
