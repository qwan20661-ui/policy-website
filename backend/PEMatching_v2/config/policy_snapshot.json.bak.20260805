      "structuredConditions": [
        {
          "id": "1090",
          "applicableTarget": "企业",
          "applicableTargetPath": "企业类-企业",
          "applicationInstruction": "2025年09月04日-2025年09月30日",
          "applicationRequirement": "申报企业需同时满足以下条件：\n1、企业依法在厦注册，且为研发项目的牵头实施单位。\n2、研发项目应由申报企业自筹资金、自行立项、自行组织实施、自行管理和自行验收（委托外单位研发的项目除外）。项目管理应按照《研发费用加计扣除政策执行指引（2.0版）》（国家税务总局和科技部于2023年7月联合发布）执行。\n3、研发项目应于2021年1月1日之后立项、2024年12月31日之前完成验收并合格，且项目实施期不超过三年。项目验收可由企业根据内部验收标准自行组织或委托第三方验收，验收可采取研发项目鉴定（评估）等方式。\n4、研发项目自主研发费用应达500万元及以上。\n5、研发项目未获得过国家、省、市科技项目立项。\n6、企业没有逾期未验收的市级科技计划项目。项目负责人、项目牵头单位和项目参与单位均未在科研违规、科研失信惩戒期内。\n7、每家企业每年最多可申报两个纳入市级重大科技计划项目的研发项目。",
          "applicationStartTime": "2025-09-04",
          "applicationEndTime": "2025-09-30",
          "announcementDate": ""
        }
      ],
      "keywords": [
        {
          "id": "2499",
          "text": "科技计划项目支持",
