{"applicationChecklistGroups":[{"checklistNo":2,"checklistType":"伦理合规","items":["伦理审查","知情同意书","人类遗传资源管理条例执行","实验动物和动物实验合规","实验动物福利和伦理审查"],"rawText":"项目研究涉及人体研究的，应按照规定通过伦理审查并签署知情同意书；涉及人类遗传资源采集、保藏、利用、对外提供等，应遵照《中华人民共和国人类遗传资源管理条例》相关规定执行；涉及实验动物和动物实验的，应遵守国家实验动物管理的法律、法规、技术标准及有关规定，使用合格实验动物，在合格设施内进行动物实验，保证实验过程合法，实验结果真实、有效，并通过实验动物福利和伦理审查。"}],"coverage":"empty","definitionNotes":[],"fusionPolicyId":"6539","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":[],"policyTitle":"厦门市医疗卫生指导性项目申报","profileHash":"c51b30fa31d2954756dd2ae7f82c08b80ca8398e0516e662376f6147792b8159","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[],"sourcePolicyUpdatedAt":"2026-07-16 16:28:47.708793","sourceRuleTableHash":"3194fe4c3917443b82bec49c77625d18522a83ee6b7233063e7c4cdb8c1878a6","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
