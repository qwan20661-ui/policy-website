{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"材料","items":["学历认证","毕业证书","学位证书","博士后出站证明"],"rawText":"须在2026年12月31日前毕业并取得相应学位（博士后出站）；境外大学毕业生须在入职前提供学历认证（未在规定时间内取得相应学历（位）或学历认证的，取消选拔或聘用资格）"},{"checklistNo":1,"checklistType":"时效","items":["博士后出站时间在2026年12月31日前","境外大学毕业生需在入职前提供学历认证"],"rawText":"须在2026年12月31日前完成博士后出站；境外大学毕业生须在入职前提供学历认证（未在规定时间内取得相应学历（位）或学历认证的，取消选拔或聘用资格）"}],"coverage":"partial","definitionNotes":[],"fusionPolicyId":"6593","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":["存在 1 个未解析片段或条件项"],"policyTitle":"厦门市优培生选拔","profileHash":"1f4d6da2039cc984ed6d43faa18bc1d6e9fd5c0c1129803ad8b348fdaa6714fd","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[{"conditionBranchId":"","conditionBranchText":"","conditionContext":"","conditionFieldItems":[{"enterpriseFields":["年龄要求"],"itemId":"2-1","itemName":"年龄要求","itemStatus":"unresolved","matchRule":{"description":"年龄限制","fieldType":"string","operator":"llm_judge","ruleId":"S2-1","ruleKind":"reference","targetValue":38,"unit":"周岁"},"policyFragment":"原则上不超过38周岁（1987年7月31日及以后出生）。","semanticItemKey":"6593:softRuleGroups:1:1","sourceFragmentId":"C2-A1","sourceStandardField":null}],"conditionNo":2,"conditionOperator":"AND","evaluationRole":"eligibility_signal","rawText":"原则上不超过38周岁（1987年7月31日及以后出生）。","unresolvedFragments":[]}],"sourcePolicyUpdatedAt":"2026-07-15 17:14:25.620985","sourceRuleTableHash":"ce7fadc975abfb268613e0f22c2160c27aa2b56b10a1536c1a481c0f84291412","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
