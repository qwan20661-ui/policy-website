{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"重复申报限制","items":["是否已获得留学人员专项扶持资金","是否为同一留学人员或同一留学人员企业","是否在厦注册或参股多家企业"],"rawText":"同一留学人员在厦注册或参股多家企业的，只能选择一家符合条件的企业进行申报，已获得留学人员专项扶持资金的同一留学人员或同一留学人员企业不可再次申报留学人员专项扶持资金。"}],"coverage":"partial","definitionNotes":[],"fusionPolicyId":"6556","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":["存在 5 个未解析片段或条件项"],"policyTitle":"厦门市留学人员创业扶持资金申报","profileHash":"3954521bb426d41df23028c42b87317461a649ac99e8a48ae1ad2b861205ca2d","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[{"conditionBranchId":"C1-B1","conditionBranchText":"留学人员年龄不超过55周岁（截至2025年5月12日），每年在厦门的工作时间不少于6个月","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C1-B1","conditionBranchText":"留学人员年龄不超过55周岁（截至2025年5月12日），每年在厦门的工作时间不少于6个月","enterpriseFields":["留学人员年龄"],"itemId":"1-1","itemName":"留学人员年龄","itemStatus":"unresolved","matchRule":{"description":"年龄上限","fieldType":"number","operator":"lte","ruleId":"S1-1","ruleKind":"reference","targetValue":55,"unit":"周岁"},"policyFragment":"留学人员年龄不超过55周岁（截至2025年5月12日）","semanticItemKey":"6556:softRuleGroups:1:1","sourceFragmentId":"C1-A1","sourceStandardField":null}],"conditionNo":1,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"留学人员年龄不超过55周岁（截至2025年5月12日）","unresolvedFragments":[]},{"conditionBranchId":"C1-B1","conditionBranchText":"留学人员年龄不超过55周岁（截至2025年5月12日），每年在厦门的工作时间不少于6个月","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C1-B1","conditionBranchText":"留学人员年龄不超过55周岁（截至2025年5月12日），每年在厦门的工作时间不少于6个月","enterpriseFields":["工作时间要求"],"itemId":"1-2","itemName":"工作时间要求","itemStatus":"unresolved","matchRule":{"description":"工作时间下限","fieldType":"number","operator":"gte","ruleId":"S1-2","ruleKind":"reference","targetValue":6,"unit":"个"},"policyFragment":"每年在厦门的工作时间不少于6个月","semanticItemKey":"6556:softRuleGroups:2:1","sourceFragmentId":"C1-A2","sourceStandardField":null}],"conditionNo":1,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"每年在厦门的工作时间不少于6个月","unresolvedFragments":[]},{"conditionBranchId":"C6-B1","conditionBranchText":"申请企业已成立半年（含）以上5年以下（即企业成立时间要求为2020年5月12日至2024年11月12日期间）","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C6-B1","conditionBranchText":"申请企业已成立半年（含）以上5年以下（即企业成立时间要求为2020年5月12日至2024年11月12日期间）","enterpriseFields":["企业成立年限"],"itemId":"6-1","itemName":"企业成立年限","itemStatus":"unresolved","matchRule":{"description":"企业成立时间要求为2020年5月12日至2024年11月12日期间","fieldType":"number","operator":"lte","ruleId":"S6-1","ruleKind":"reference","targetValue":5,"unit":"年"},"policyFragment":"申请企业已成立半年（含）以上5年以下（即企业成立时间要求为2020年5月12日至2024年11月12日期间）","semanticItemKey":"6556:softRuleGroups:3:1","sourceFragmentId":"C6-A1","sourceStandardField":null}],"conditionNo":6,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"申请企业已成立半年（含）以上5年以下（即企业成立时间要求为2020年5月12日至2024年11月12日期间）","unresolvedFragments":[]},{"conditionBranchId":"C6-B2","conditionBranchText":"已投入的与研发有直接关系的科学仪器设备、材料费、电脑、服务器、委托外单位研发费用、委托外单位检测费用不低于20万元。企业正式员工近4个月内（2025年1月-2025年4月）一直保持5（含）人以上，其中研发人员不少于3人","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C6-B2","conditionBranchText":"已投入的与研发有直接关系的科学仪器设备、材料费、电脑、服务器、委托外单位研发费用、委托外单位检测费用不低于20万元。企业正式员工近4个月内（2025年1月-2025年4月）一直保持5（含）人以上，其中研发人员不少于3人","enterpriseFields":["研发费用投入"],"itemId":"6-2","itemName":"研发费用投入","itemStatus":"unresolved","matchRule":{"description":"研发相关投入不低于20万元","fieldType":"number","operator":"gte","ruleId":"S6-2","ruleKind":"reference","targetValue":20,"unit":"万元"},"policyFragment":"已投入的与研发有直接关系的科学仪器设备、材料费、电脑、服务器、委托外单位研发费用、委托外单位检测费用不低于20万元","semanticItemKey":"6556:softRuleGroups:4:1","sourceFragmentId":"C6-A2","sourceStandardField":null}],"conditionNo":6,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"已投入的与研发有直接关系的科学仪器设备、材料费、电脑、服务器、委托外单位研发费用、委托外单位检测费用不低于20万元","unresolvedFragments":[]},{"conditionBranchId":"C6-B2","conditionBranchText":"已投入的与研发有直接关系的科学仪器设备、材料费、电脑、服务器、委托外单位研发费用、委托外单位检测费用不低于20万元。企业正式员工近4个月内（2025年1月-2025年4月）一直保持5（含）人以上，其中研发人员不少于3人","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C6-B2","conditionBranchText":"已投入的与研发有直接关系的科学仪器设备、材料费、电脑、服务器、委托外单位研发费用、委托外单位检测费用不低于20万元。企业正式员工近4个月内（2025年1月-2025年4月）一直保持5（含）人以上，其中研发人员不少于3人","enterpriseFields":["研发人员数量"],"itemId":"6-4","itemName":"研发人员数量","itemStatus":"unresolved","matchRule":{"description":"研发人员数量不少于3人","fieldType":"string","operator":"llm_judge","ruleId":"S6-4","ruleKind":"reference","targetValue":3,"unit":"人"},"policyFragment":"其中研发人员不少于3人","semanticItemKey":"6556:softRuleGroups:5:1","sourceFragmentId":"C6-A4","sourceStandardField":null}],"conditionNo":6,"conditionOperator":"AND","evaluationRole":"eligibility_signal","rawText":"其中研发人员不少于3人","unresolvedFragments":[]}],"sourcePolicyUpdatedAt":"2026-07-20 10:21:51.413053","sourceRuleTableHash":"bc72906bf84cb131114dadc5222796f52e916fb9422a97143b32468e77285e6e","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"申报方式","items":["高校牵头申报数量限制","高校合作申报数量限制","高校具体数量分配表"],"rawText":"每个企事业单位本年度只能作为牵头单位或合作单位申报1个项目。大学以学院为项目申报单位，具有独立法人资格的学院以系或二级学院为项目申报单位；对上述高校牵头申报及合作申报本年度进行限项申报，具体数量分配见下表："},{"checklistNo":1,"checklistType":"申报方式","items":["同一平台项目合作双方只能选择通过一个设区市进行申报","多头、重复申报将直接取消申报资格"],"rawText":"同一平台项目合作双方只能选择通过一个设区市进行申报，多头、重复申报将直接取消申报资格。"},{"checklistNo":1,"checklistType":"材料","items":["国家、省级科技创新平台认定文件","设区市政府重点建设的相关佐证材料（市政府会议纪要、合作协议等）"],"rawText":"项目申报时合作双方均需提供国家、省级科技创新平台认定文件或设区市政府重点建设的相关佐证材料（市政府会议纪要、合作协议等）"},{"checklistNo":2,"checklistType":"时效","items":["项目实施周期为2年"],"rawText":"项目实施周期原则上为2年"},{"checklistNo":1,"checklistType":"材料","items":["近三个年度的资产负债表","现金流量表","利润表","企业研发经费投入结构明细表（附件3）","有效期内的高新技术企业证书（国家高新技术企业）"],"rawText":"项目申报单位或合作单位为企业的，需提供近三个年度的资产负债表、现金流量表和利润表；同时还要提供能体现研发经费投入比例的企业研发经费投入结构明细表（附件3），国家高新技术企业的仅需提供有效期内的高新技术企业证书。"},{"checklistNo":1,"checklistType":"重复申报限制","items":["尚未验收的承担单位","尚未验收的合作单位","双方项目负责人作为牵头单位或合作单位","协同创新内容已获得省级财政资金支持"],"rawText":"不支持福厦泉自创区协同创新平台项目尚未验收的承担单位、合作单位及双方项目负责人作为牵头单位（项目负责人）或合作单位（项目负责人）之一申报本年度新项目。协同创新内容已获得省级财政资金支持的，不得重复申请支持。"},{"checklistNo":1,"checklistType":"材料","items":["保证所提供申报平台项目信息的真实性","保证有关条件符合申报要求","对隐瞒相关信息或信息虚假导致的后果承担相应责任"],"rawText":"项目申报牵头单位和合作单位及双方项目负责人应保证所提供申报平台项目信息的真实性，并保证有关条件符合申报要求，对隐瞒相关信息或信息虚假导致的后果承担相应责任。"},{"checklistNo":1,"checklistType":"材料","items":["待准备或待核验的事项"],"rawText":"由厦门市科技局组织平台项目牵头单位进行申报，厦门片区限额推荐16项（含其他设区市征集报送的项目数且原则上不少于4项；其他设区市征集报送的项目数如未达4项的，以实际推荐数为准，直接扣除未推荐的指标）。"},{"checklistNo":2,"checklistType":"流程","items":["待准备或待核验的事项"],"rawText":"省科技厅将根据征集推荐的协同创新平台项目情况，开展评审，确定拟支持的协同创新平台项目和资金数额。厦门市科技局根据省科技厅确定的拟支持的协同创新平台项目清单，按承担单位属地化管理原则，组织定向申报和签订协同创新平台项目任务书，并开展后续管理和验收等工作，合作单位所在地设区市科技部门做好配合。"},{"checklistNo":3,"checklistType":"时效","items":["待准备或待核验的事项"],"rawText":"在签订任务书时，协同创新的关键内容不得调整，协同开展的服务、技术、经济和辐射带动效益等指标不得低于征集时的要求。"},{"checklistNo":1,"checklistType":"材料","items":["向厦门市科技局抄送相关推荐项目"],"rawText":"漳州、三明、莆田、龙岩、南平、宁德市科技局可按省科技厅通知要求向厦门市科技局抄送相关推荐项目。"}],"coverage":"empty","definitionNotes":[],"fusionPolicyId":"6558","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":[],"policyTitle":"福厦泉国家自主创新示范区协同创新平台项目征集","profileHash":"eae615396608170430ab544bacbf140a8740d2cdf509f1b30d3a3f73afe10ac5","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[],"sourcePolicyUpdatedAt":"2026-07-20 10:38:09.078934","sourceRuleTableHash":"41dc639a1995a8355b63bb8e1c80eaf93a6ce2a0cf2a4fa158afdf2e85abe771","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"材料","items":["国家认证认可检测机构的检测（评测）","相关行业主管部门批准颁发的产品生产许可","强制性产品认证"],"rawText":"项目所形成的产品应通过国家认证认可检测机构的检测（评测）。属医药、医疗器械、农药、计量器具、压力容器、邮电通信等有特殊行业管理要求的产品，须具有相关行业主管部门批准颁发的产品生产许可。属国家实施强制性产品认证的产品，必须通过强制性产品认证；"}],"coverage":"partial","definitionNotes":[],"fusionPolicyId":"6559","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":["存在 3 个未解析片段或条件项"],"policyTitle":"厦门市高新技术成果转化项目认定","profileHash":"46a9022ecaec91baaaa5a001a59c00527092e4352b7a6781f226fbf062d56e8f","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[{"conditionBranchId":"C5-B1","conditionBranchText":"项目技术成熟，近2年内实现年均销售收入500万元以上或纳税100万元以上（软件产品近2年内实现年均销售收入300万元或纳税60万元以上）。\n　　（二）认定要求","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C5-B1","conditionBranchText":"项目技术成熟，近2年内实现年均销售收入500万元以上或纳税100万元以上（软件产品近2年内实现年均销售收入300万元或纳税60万元以上）。\n　　（二）认定要求","enterpriseFields":["年销售收入"],"itemId":"5-3","itemName":"年销售收入","itemStatus":"unresolved","matchRule":{"description":"近2年内年均销售收入（软件产品）","fieldType":"number","operator":"gte","ruleId":"S5-3","ruleKind":"reference","targetValue":60,"unit":"万元"},"policyFragment":"（软件产品近2年内实现年均销售收入300万元或纳税60万元以上）","semanticItemKey":"6559:softRuleGroups:1:1","sourceFragmentId":"C5-A3","sourceStandardField":null}],"conditionNo":5,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"（软件产品近2年内实现年均销售收入300万元或纳税60万元以上）","unresolvedFragments":[]},{"conditionBranchId":"C2-B1","conditionBranchText":"每家企业当年度申报高转项目数不超过2项，项目名称应体现核心技术及产品，单个项目为单一产品，该产品的型号不超过3个","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C2-B1","conditionBranchText":"每家企业当年度申报高转项目数不超过2项，项目名称应体现核心技术及产品，单个项目为单一产品，该产品的型号不超过3个","enterpriseFields":["申报高转项目数"],"itemId":"2-1","itemName":"申报高转项目数","itemStatus":"unresolved","matchRule":{"description":"每家企业当年度申报高转项目数不超过2项","fieldType":"number","operator":"lte","ruleId":"S2-1","ruleKind":"reference","targetValue":2,"unit":"项"},"policyFragment":"每家企业