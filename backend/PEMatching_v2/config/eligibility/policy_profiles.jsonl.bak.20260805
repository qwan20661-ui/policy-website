{"applicationChecklistGroups":[],"coverage":"empty","definitionNotes":[],"fusionPolicyId":"6598","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":[],"policyTitle":"福建省自然科学研究系列专业技术职务任职资格申报","profileHash":"bf077cf24da4b2c0027fde6804e88a530a93d6ad7b09bea0b2b01f886db46a45","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[],"sourcePolicyUpdatedAt":"2026-07-20 10:27:59.954707","sourceRuleTableHash":"c10c3da4f6d8075fca1441a2bb112f1978df1d1fddd6baf566e740c28bce90c2","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[],"coverage":"empty","definitionNotes":[],"fusionPolicyId":"6601","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":[],"policyTitle":"厦门市青年科技人员育成项目遴选","profileHash":"7d5025975965f64686d7ef43bf3c58ee2613b232438e7ed4a649e823ea648343","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[],"sourcePolicyUpdatedAt":"2026-08-04 17:32:20.143657","sourceRuleTableHash":"0c194c2d49fab7f71dd8775459acd49797a73e5994c81eed2e3a5e730ade4bd2","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[],"coverage":"empty","definitionNotes":[],"fusionPolicyId":"6602","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":[],"policyTitle":"厦门市引进高层次创业创新人才（创新人才项目）申报","profileHash":"8873b4eba8d90750b6da66fc5e28b294f1f9b46a76a3c7211a9bdfdafa67d473","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[],"sourcePolicyUpdatedAt":"2026-07-15 16:41:12.268952","sourceRuleTableHash":"622f095aaf6d5ecf792222feeafc8b0bcc8fe3376b7cf9443b8e068fd11a502d","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"材料","items":["营业执照","法人资格证明","科研开发能力证明"],"rawText":"项目牵头申报单位必须是在闽具有法人资格并具备科研开发能力和条件的企事业单位。"},{"checklistNo":2,"checklistType":"流程","items":["经费预算编制","资助额度确认"],"rawText":"申请项目资助经费预算应合理、科学,单个项目申请资助额度不超过 100 万元。"},{"checklistNo":3,"checklistType":"时效","items":["年报提交","审核通过"],"rawText":"项目承担单位每年应向福建省烟草专卖局提交项目执行情况年报,报告年度研究工作开展情况和经费使用情况,省烟草专卖局审核通过后予以拨付当年度项目经费。"},{"checklistNo":4,"checklistType":"材料","items":["经费发票开具","发票报送"],"rawText":"项目承担单位每年度在收到项目经费后,应于 10 个工作日内开具经费发票报送至中国烟草总公司福建省公司(发票抬头)。"},{"checklistNo":6,"checklistType":"流程","items":["项目推荐流程","推荐材料审核"],"rawText":"推荐部门在推荐项目时,应公开征集、逐级遴选、认真核实、择优推荐,不得内部指定、简单分配。"},{"checklistNo":7,"checklistType":"材料","items":["项目申报内容","技术指标量化"],"rawText":"项目申报内容应符合指南中规定的重点支持方向和领域范围;项目目标任务应明确具体,体现项目创新性,技术指标应量化可考核,形成具有自主知识产权的技术成果。"},{"checklistNo":8,"checklistType":"材料","items":["伦理审查批准","伦理审查材料"],"rawText":"项目申报时,涉及人、实验动物等具有科技伦理风险的研究,应当按照《科技伦理审查办法》(国科发监〔2023〕167 号)由申报单位科技伦理审查委员会审查批准。"},{"checklistNo":11,"checklistType":"材料","items":["研发投入证明","研发费用明细"],"rawText":"为推动企业加大研发投入,夯实企业科技创新主体地位。各推荐主管部门应将企业研发投入情况与科技资源配置紧密挂钩,对研发投入占比高于 5%的或年度自主研发费用 2000 万元以上的企业,优先推荐申报本计划项目。"},{"checklistNo":12,"checklistType":"材料","items":["项目类型限制","项目申请清单"],"rawText":"企业作为牵头申报单位的,当年度申报科技重大专项专题、区域发展项目、科技型中小企业技术创新资金项目、星火项目、对外合作项目、引导性项目、院省科技合作项目、协同创新平台项目和中央引导地方科技发展项目等类型项目时,只能申请其中 1 个项目。"},{"checklistNo":13,"checklistType":"材料","items":["团队组建材料","人才推荐证明"],"rawText":"各推荐主管部门、项目承担单位应推动整合优势创新团队,积极吸纳女性科研人员、青年科研人员,高技能科研人员等群体参与项目研发,支持青年科技人才“担大任”“挑大梁”,鼓励有能力的女性科技人才、青年科技人才,高技能人才等作为项目负责人领衔担纲承担任务。"},{"checklistNo":14,"checklistType":"材料","items":["申报材料完整性","形式审查"],"rawText":"对因未按本通知要求申报,或形式审查不通过的,将不再受理该项目。"}],"coverage":"partial","definitionNotes":[],"fusionPolicyId":"6605","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":["存在 2 个未解析片段或条件项"],"policyTitle":"厦门市联合资助项目申报","profileHash":"7245a95fadf24ac334b062eca75d6ba2349dab93a6eadbebef5ff63ea10ddb95","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[{"conditionBranchId":"","conditionBranchText":"","conditionContext":"","conditionFieldItems":[{"enterpriseFields":["项目资助额度"],"itemId":"1-1","itemName":"项目资助额度","itemStatus":"unresolved","matchRule":{"description":"项目资助额度上限","fieldType":"number","operator":"lte","ruleId":"S1-1","ruleKind":"reference","targetValue":100,"unit":"万元"},"policyFragment":"单个项目申请资助额度不超过 100 万元。","semanticItemKey":"6605:softRuleGroups:1:1","sourceFragmentId":"C1-A1","sourceStandardField":null}],"conditionNo":1,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"单个项目申请资助额度不超过 100 万元。","unresolvedFragments":[]},{"conditionBranchId":"","conditionBranchText":"","conditionContext":"","conditionFieldItems":[{"enterpriseFields":["项目负责人年龄"],"itemId":"1-2","itemName":"项目负责人年龄","itemStatus":"unresolved","matchRule":{"description":"项目负责人年龄限制","fieldType":"string","operator":"llm_judge","ruleId":"S1-2","ruleKind":"reference","targetValue":"不超过延迟退休后的法定退休年龄","unit":""},"policyFragment":"项目负责人在项目结束时年龄原则上不超过延迟退休后的法定退休年龄;由企业牵头申报的项目,项目结束时负责人年龄可以放宽到 65 周岁。","semanticItemKey":"6605:softRuleGroups:2:1","sourceFragmentId":"C1-A2","sourceStandardField":null}],"conditionNo":1,"conditionOperator":"AND","evaluationRole":"eligibility_signal","rawText":"项目负责人在项目结束时年龄原则上不超过延迟退休后的法定退休年龄;由企业牵头申报的项目,项目结束时负责人年龄可以放宽到 65 周岁。","unresolvedFragments":[]}],"sourcePolicyUpdatedAt":"2026-07-15 17:20:11.455832","sourceRuleTableHash":"f02766aa2e363f5c6fde2d192ffbe577622f154bfc08dd2b9bca51b72f5262db","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
