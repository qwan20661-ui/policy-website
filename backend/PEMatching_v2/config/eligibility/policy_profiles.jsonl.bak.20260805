sRuleGroups":[]}
{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"材料","items":["依法在中国境内设立的证明材料","对外合作渠道和能力证明","科研条件和能力证明","法人资格证明","提供在华必要工作条件的证明","出具来华工作邀请函的证明","协助办理入境签证、外国人居留证等相关手续的证明","保障国际杰青来华生活等相关需要的证明","提供必要科研条件的证明","配套资金支付国际杰青行政管理开支、国内差旅费的证明","承担国际杰青管理及答疑工作的证明","向中国科学技术交流中心报送进展、总结、决算及收据等各类材料的证明"],"rawText":"（1）是依法在中国境内设立，具有相应对外合作渠道和能力、具备相应科研条件和能力且具有法人资格的科研院所、高校或企业；（2）能为国际杰青提供在华必要工作条件；（3）能够向国际杰青出具来华工作邀请函并协助国际杰青办理入境签证、外国人居留证等相关手续；（4）在申请资助经费审批期间，资助经费到账前，能够保障国际杰青来华生活等相关需要；（5）能够提供必要科研条件以及配套资金支付国际杰青行政管理开支、国内差旅费等；（6）能够承担国际杰青管理及答疑工作，并向中国科学技术交流中心（以下简称“交流中心”）及时报送进展、总结、决算及收据等各类材料。"}],"coverage":"partial","definitionNotes":[],"fusionPolicyId":"6476","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":["存在 4 个未解析片段或条件项"],"policyTitle":"国际杰青计划项目申报","profileHash":"a6513b4d4b5be7f3acf97293f57fbfd29eff80b0b397f9bdc3e4bd8de6ca971c","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[{"conditionBranchId":"C3-B5","conditionBranchText":"（5）年龄不超过45岁（按申请工作岗位之日计算）且身体健康","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C3-B5","conditionBranchText":"（5）年龄不超过45岁（按申请工作岗位之日计算）且身体健康","enterpriseFields":["年龄"],"itemId":"3-1","itemName":"年龄","itemStatus":"unresolved","matchRule":{"description":"年龄不超过45岁","fieldType":"number","operator":"lte","ruleId":"S3-1","ruleKind":"reference","targetValue":45,"unit":"岁"},"policyFragment":"年龄不超过45岁（按申请工作岗位之日计算）","semanticItemKey":"6476:softRuleGroups:1:1","sourceFragmentId":"C3-A1","sourceStandardField":null}],"conditionNo":3,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"年龄不超过45岁（按申请工作岗位之日计算）","unresolvedFragments":[]},{"conditionBranchId":"C3-B3","conditionBranchText":"（3）具有博士学位或具有5年以上科研工作经历","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C3-B3","conditionBranchText":"（3）具有博士学位或具有5年以上科研工作经历","enterpriseFields":["科研工作经历"],"itemId":"3-2","itemName":"科研工作经历","itemStatus":"unresolved","matchRule":{"description":"具有博士学位或5年以上科研工作经历","fieldType":"number","operator":"gte","ruleId":"S3-2","ruleKind":"reference","targetValue":5,"unit":"年"},"policyFragment":"具有博士学位或具有5年以上科研工作经历","semanticItemKey":"6476:softRuleGroups:2:1","sourceFragmentId":"C3-A2","sourceStandardField":null}],"conditionNo":3,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"具有博士学位或具有5年以上科研工作经历","unresolvedFragments":[]},{"conditionBranchId":"C3-B6","conditionBranchText":"（6）具有良好的英语或汉语语言沟通能力","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C3-B6","conditionBranchText":"（6）具有良好的英语或汉语语言沟通能力","enterpriseFields":["语言能力"],"itemId":"3-3","itemName":"语言沟通能力","itemStatus":"unresolved","matchRule":{"description":"具有良好的英语或汉语语言沟通能力","fieldType":"string","operator":"llm_judge","ruleId":"S3-3","ruleKind":"reference","targetValue":"良好的英语或汉语语言沟通能力","unit":""},"policyFragment":"具有良好的英语或汉语语言沟通能力","semanticItemKey":"6476:softRuleGroups:3:1","sourceFragmentId":"C3-A3","sourceStandardField":null}],"conditionNo":3,"conditionOperator":"AND","evaluationRole":"eligibility_signal","rawText":"具有良好的英语或汉语语言沟通能力","unresolvedFragments":[]},{"conditionBranchId":"C3-B7","conditionBranchText":"（7）须能在申请期内全职在华工作","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C3-B7","conditionBranchText":"（7）须能在申请期内全职在华工作","enterpriseFields":["项目实施条件"],"itemId":"3-4","itemName":"全职在华工作","itemStatus":"unresolved","matchRule":{"description":"须能在申请期内全职在华工作","fieldType":"string","operator":"llm_judge","ruleId":"S3-4","ruleKind":"reference","targetValue":"全职在华工作","unit":""},"policyFragment":"须能在申请期内全职在华工作","semanticItemKey":"6476:softRuleGroups:4:1","sourceFragmentId":"C3-A4","sourceStandardField":null}],"conditionNo":3,"conditionOperator":"AND","evaluationRole":"eligibility_signal","rawText":"须能在申请期内全职在华工作","unresolvedFragments":[]}],"sourcePolicyUpdatedAt":"2026-07-15 18:21:45.418895","sourceRuleTableHash":"174a4968709aad5adc9dbb8f259382ec6b5e970b6a399170cc327154c9715b57","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[],"coverage":"partial","definitionNotes":[],"fusionPolicyId":"6479","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":["存在 2 个未解析片段或条件项"],"policyTitle":"福建省引导性项目申报","profileHash":"a53ee2fb70e2c3edb5d5ae8ef72c64dc963b1f3ccf901af01e06735beb593827","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[{"conditionBranchId":"","conditionBranchText":"","conditionContext":"","conditionFieldItems":[{"enterpriseFields":["资助经费额度"],"itemId":"5-1","itemName":"资助经费额度","itemStatus":"unresolved","matchRule":{"description":"资助经费额度上限","fieldType":"number","operator":"lte","ruleId":"S5-1","ruleKind":"reference","targetValue":"20","unit":"万元"},"policyFragment":"引导性项目单个项目申请资助经费额度不超过20万元，原则上不低于10万元。","semanticItemKey":"6479:softRuleGroups:1:1","sourceFragmentId":"C5-A1","sourceStandardField":null}],"conditionNo":5,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"引导性项目单个项目申请资助经费额度不超过20万元，原则上不低于10万元。","unresolvedFragments":[]},{"conditionBranchId":"","conditionBranchText":"","conditionContext":"","conditionFieldItems":[{"enterpriseFields":["资助经费额度"],"itemId":"5-2","itemName":"资助经费额度","itemStatus":"unresolved","matchRule":{"description":"资助经费额度下限","fieldType":"number","operator":"gte","ruleId":"S5-2","ruleKind":"reference","targetValue":"10","unit":"万元"},"policyFragment":"引导性项目单个项目申请资助经费额度不超过20万元，原则上不低于10万元。","semanticItemKey":"6479:softRuleGroups:2:1","sourceFragmentId":"C5-A2","sourceStandardField":null}],"conditionNo":5,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"引导性项目单个项目申请资助经费额度不超过20万元，原则上不低于10万元。","unresolvedFragments":[]}],"sourcePolicyUpdatedAt":"2026-07-20 10:42:37.191462","sourceRuleTableHash":"5dfc0f9d518ffba313755fbba229442c36322e88004765aa554d74c8d06d275e","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"材料","items":["项目申报内容需符合重点支持方向和领域范围","项目目标任务需明确具体并体现创新性","技术指标需量化可考核","形成具有自主知识产权的技术成果"],"rawText":"项目申报内容应符合指南中规定的重点支持方向和领域范围；项目目标任务应明确具体，体现项目创新性，技术指标应量化可考核，形成具有自主知识产权的技术成果。"},{"checklistNo":2,"checklistType":"流程","items":["涉及人、实验动物等具有科技伦理风险的研究需经科技伦理审查委员会审查批准"],"rawText":"项目申报时，涉及人、实验动物等具有科技伦理风险的研究，应当按照《科技伦理审查办法》（国科发监〔2023〕167号）由申报单位科技伦理审查委员会审查批准。"},{"checklistNo":4,"checklistType":"材料","items":["项目申报单位需保证所提供信息的真实性","对信息虚假导致的后果承担责任"],"rawText":"项目申报单位应保证所提供申报项目信息的真实性，并对信息虚假导致的后果承担责任。"},{"checklistNo":5,"checklistType":"材料","items":["申报项目有合作单位的需提交合作协议","协议内容需包括项目研究开发内容及分工、知识产权权属、经费筹措及资助经费分配"],"rawText":"申报项目有合作单位的，应提交合作协议作为申报材料附件，协议内容一般包括：项目研究开发内容及分工、知识产权权属、经费筹措及资助经费分配等。"},{"checklistNo":6,"checklistType":"材料","items":["项目承担单位需在实施完成或中期评估时提交科技报告","需通过福建省科技计划项目信息管理系统提交"],"rawText":"获批立项的省科技计划项目在实施完成或中期评估时，项目承担单位应根据《福建省科技计划项目科技报告暂行管理办法》及其实施方案要求，通过福建省科技计划项目信息管理系统提交科技报告。"},{"checklistNo":7,"checklistType":"材料","items":["企业牵头申报项目需建立研发准备金制度","需通过福建省科技计划项目信息管理系统备案"],"rawText":"由企业牵头申报的省科技计划项目获批立项后，牵头企业应在项目实施期内建立研发准备金制度，并通过福建省科技计划项目信息管理系统备案。"},{"checklistNo":8,"checklistType":"流程","items":["推荐申报项目工作需破除“唯论文、唯职称、唯学历、唯奖项”不良倾向"],"rawText":"各推荐单位要认真贯彻落实中央关于科技评价改革部署和我省工作要求，推荐申报项目工作要破除“唯论文、唯职称、唯学历、唯奖项”不良倾向。"},{"checklistNo":9,"checklistType":"流程","items":["限项推荐项目需公开征集、逐级遴选、认真核实、择优推荐","不得内部指定、简单分配"],"rawText":"对限项推荐的项目，应公开征集、逐级遴选、认真核实、择优推荐，不得内部指定、简单分配。"},{"checklistNo":10,"checklistType":"流程","items":["推荐单位需安排不少于50%推荐申报指标","支持研发费用占营业收入比重高于5%或年度自主研发费用2000万元以上的企业申报"],"rawText":"对区域发展项目、对外合作产业化项目、科技型中小企业技术创新资金项目、星火项目、院省合作计划项目等5类省科技计划项目，各推荐单位安排不少于50%推荐申报指标，支持研发费用占营业收入比重高于5%或年度自主研发费用2000万元以上的企业申报。"},{"checklistNo":11,"checklistType":"流程","items":["2025年以来入选特定人才项目的人才可单列推荐指标","不受本地区或用人单位推荐指标名额限制","同期不能申报或承担两项及以上省级科技计划项目"],"rawText":"对2025年以来入选省特级后备人才、科技创新领军人才、产业领军团队、“雏鹰计划”青年拔尖人才项目的人才，依托省内用人单位申报省科技计划项目，可单列推荐指标，不受本地区或用人单位推荐指标名额的限制（同期不能申报或承担两项及以上省级科技计划项目）。"},{"checklistNo":12,"checklistType":"流程","items":["推荐单位需严把项目质量关、合规关","审核项目申报单位和项目负责人科研诚信和社会信用情况","对失信被执行人申报的项目不得推荐"],"rawText":"各推荐单位应严把项目的质量关、合规关，认真审核项目申报单位和项目负责人科研诚信和社会信用情况，对失信被执行人申报的项目不得推荐。"},{"checklistNo":13,"checklistType":"时效","items":["未按要求申报或形式审查不通过的项目将不再受理补充材料或其他项目补充申报"],"rawText":"对因未按本通知要求申报，或形式审查不通过的，我厅将不再受理该项目补充材料或其他项目补充申报。"}],"coverage":"partial","definitionNotes":[],"fusionPolicyId":"6480","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":["存在 2 个未解析片段或条件项"],"policyTitle":"福建省科技计划项目申报","profileHash":"8c44a5136d9497ac0f2c9b7ff80ca64ec6e38d675bfe2814bcaf707b1a86b763","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[{"conditionBranchId":"","conditionBranchText":"","conditionContext":"","conditionFieldItems":[{"enterpriseFields":["研发机构"],"itemId":"1-1","itemName":"研发机构","itemStatus":"unresolved","matchRule":{"description":"规模以上工业企业需建有研发机构并开展研发活动","fieldType":"string","operator":"llm_judge","ruleId":"S1-1","ruleKind":"reference","targetValue":"建有研发机构并开展研发活动","unit":""},"policyFragment":"规模以上工业企业申报省级科技计划项目，须建有研发机构并开展研发活动。","semanticItemKey":"6480:softRuleGroups:1:1","sourceFragmentId":"C1-A1","sourceStandardField":null}],"conditionNo":1,"conditionOperator":"AND","evaluationRole":"eligibility_signal","rawText":"规模以上工业企业申报省级科技计划项目，须建有研发机构并开展研发活动。","unresolvedFragments":[]},{"conditionBranchId":"C1-B1","conditionBranchText":"项目研究开发内容及分工、知识产权权属、经费筹措及资助经费分配等。 \n（九）区域发展项目、对外合作产业化项目、科技型中小企业技术创新资金项目、星火项目等4类省级科技计划项目资助方式采取“事前立项、事后补助”。项目验收之后根据任务完成情况和项目投入情况给予项目补助。 \n（十）获批立项的省科技计划项目在实施完成或中期评估时，项目承担单位应根据《福建省科技计划项目科技报告暂行管理办法》及其实施方案要求，通过福建省科技计划项目信息管理系统提交科技报告。 \n（十一）由企业牵头申报的省科技计划项目获批立项后，牵头企业应在项目实施期内建立研发准备金制度，并通过福建省科技计划项目信息管理系统备案。\n 二、项目推荐有关要求 \n（一）为提高项目申报质量，区域发展项目、科技型中小企业技术创新资金项目、星火项目、省级科技特派员后补助项目、对外合作项目、引导性项目、自然科学基金项目、高校产学合作项目、创新战略研究项目、院省合作计划项目、省属公益类科研院所基本科研专项（竞争性项目）、支持设区市农科院所建设专项等12类省科技计划项目采取限项推荐方式，请各推荐单位按照附件中申报指南分配的推荐指标推荐申报项目。 \n（二）星创天地建设后补助项目、省级新型研发机构非财政资金购买科研仪器设备软件后补助项目、重大科技成果购买补助项目、国家重大科技项目和国家级科技创新平台奖补、创新药物研发奖励补助项目等5类省科技奖补项目采取不限项推荐方式，不设置项目推荐指标，符合条件的均可以申报。 \n（三）各推荐单位要认真贯彻落实中央关于科技评价改革部署和我省工作要求，推荐申报项目工作要破除“唯论文、唯职称、唯学历、唯奖项”不良倾向。对限项推荐的项目，应公开征集、逐级遴选、认真核实、择优推荐，不得内部指定、简单分配。要鼓励引导项目申报单位整合优势创新团队，积极吸纳女性科研人员、青年科研人员、高技能科研人员等群体参与项目研发，支持青年科技人才“担大任”“挑大梁”，鼓励有能力的女性科技人才、青年科技人才，高技能人才等作为项目负责人领衔担纲承担任务。 \n（四）对区域发展项目、对外合作产业化项目、科技型中小企业技术创新资金项目、星火项目、院省合作计划项目等5类省科技计划项目，各推荐单位安排不少于50%推荐申报指标，支持研发费用占营业收入比重高于5%或年度自主研发费用2000万元以上的企业申报。对建立研发准备金制度的企业，各推荐单位优先推荐申报各类科技计划项目。 \n（五）2025年以来入选省特级后备人才、科技创新领军人才、产业领军团队、“雏鹰计划”青年拔尖人才项目的人才，依托省内用人单位申报省科技计划项目，可单列推荐指标，不受本地区或用人单位推荐指标名额的限制（同期不能申报或承担两项及以上省级科技计划项目）。省重点产业链县域特聘专家团依托省内相关企业申报省科技计划项目，符合条件的可给予优先推荐，其中对顾问科学家牵头的项目，可以推荐指标单列方式支持。 \n（六）各推荐单位应严把项目的质量关、合规关，认真审核项目申报单位和项目负责人科研诚信和社会信用情况，对失信被执行人申报的项目不得推荐。对因未按本通知要求申报，或形式审查不通过的，我厅将不再受理该项目补充材料或其他项目补充申报","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C1-B1","conditionBranchText":"项目研究开发内容及分工、知识产权权属、经费筹措及资助经费分配等。 \n（九）区域发展项目、对外合作产业化项目、科技型中小企业技术创新资金项目、星火项目等4类省级科技计划项目资助方式采取“事前立项、事后补助”。项目验收之后根据任务完成情况和项目投入情况给予项目补助。 \n（十）获批立项的省科技计划项目在实施完成或中期评估时，项目承担单位应根据《福建省科技计划项目科技报告暂行管理办法》及其实施方案要求，通过福建省科技计划项目信息管理系统提交科技报告。 \n（十一）由企业牵头申报的省科技计划项目获批立项后，牵头企业应在项目实施期内建立研发准备金制度，并通过福建省科技计划项目信息管理系统备案。\n 二、项目推荐有关要求 \n（一）为提高项目申报质量，区域发展项目、科技型中小企业技术创新资金项目、星火项目、省级科技特派员后补助项目、对外合作项目、引导性项目、自然科学基金项目、高校产学合作项目、创新战略研究项目、院省合作计划项目、省属公益类科研院所基本科研专项（竞争性项目）、支持设区市农科院所建设专项等12类省科技计划项目采取限项推荐方式，请各推荐单位按照附件中申报指南分配的推荐指标推荐申报项目。 \n（二）星创天地建设后补助项目、省级新型研发机构非财政资金购买科研仪器设备软件后补助项目、重大科技成果购买补助项目、国家重大科技项目和国家级科技创新平台奖补、创新药物研发奖励补助项目等5类省科技奖补项目采取不限项推荐方式，不设置项目推荐指标，符合条件的均可以申报。 \n（三）各推荐单位要认真贯彻落实中央关于科技评价改革部署和我省工作要求，推荐申报项目工作要破除“唯论文、唯职称、唯学历、唯奖项”不良倾向。对限项推荐的项目，应公开征集、逐级遴选、认真核实、择优推荐，不得内部指定、简单分配。要鼓励引导项目申报单位整合优势创新团队，积极吸纳女性科研人员、青年科研人员、高技能科研人员等群体参与项目研发，支持青年科技人才“担大任”“挑大梁”，鼓励有能力的女性科技人才、青年科技人才，高技能人才等作为项目负责人领衔担纲承担任务。 \n（四）对区域发展项目、对外合作产业化项目、科技型中小企业技术创新资金项目、星火项目、院省合作计划项目等5类省科技计划项目，各推荐单位安排不少于50%推荐申报指标，支持研发费用占营业收入比重高于5%或年度自主研发费用2000万元以上的企业申报。对建立研发准备金制度的企业，各推荐单位优先推荐申报各类科技计划项目。 \n（五）2025年以来入选省特级后备人才、科技创新领军人才、产业领军团队、“雏鹰计划”青年拔尖人才项目的人才，依托省内用人单位申报省科技计划项目，可单列推荐指标，不受本地区或用人单位推荐指标名额的限制（同期不能申报或承担两项及以上省级科技计划项目）。省重点产业链县域特聘专家团依托省内相关企业申报省科技计划项目，符合条件的可给予优先推荐，其中对顾问科学家牵头的项目，可以推荐指标单列方式支持。 \n（六）各推荐单位应严把项目的质量关、合规关，认真审核项目申报单位和项目负责人科研诚信和社会信用情况，对失信被执行人申报的项目不得推荐。对因未按本通知要求申报，或形式审查不通过的，我厅将不再受理该项目补充材料或其他项目补充申报","enterpriseFields":["研发准备金制度"],"itemId":"1-2","itemName":"研发准备金制度","itemStatus":"unresolved","matchRule":{"description":"企业需建立研发准备金制度","fieldType":"string","operator":"llm_judge","ruleId":"S1-2","ruleKind":"reference","targetValue":"建立研发准备金制度","unit":""},"policyFragment":"对建立研发准备金制度的企业，各推荐单位优先推荐申报各类科技计划项目。","semanticItemKey":"6480:softRuleGroups:2:1","sourceFragmentId":"C1-A2","sourceStandardField":null}],"conditionNo":1,"conditionOperator":"AND","evaluationRole":"eligibility_signal","rawText":"对建立研发准备金制度的企业，各推荐单位优先推荐申报各类科技计划项目。","unresolvedFragments":[]}],"sourcePolicyUpdatedAt":"2026-07-30 10:29:10.420410","sourceRuleTableHash":"780beba4c43799391a39a358fa4b012778759155677d6a2cef5b65cd0780503e","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"材料","items":["附件中的申报指南","《福建省科技计划项目管理办法》有关规定和要求","科技伦理审查委员会审查批准"],"rawText":"（一）17类省科技计划和奖补项目的具体申报要求详见附件中的申报指南，并须符合《福建省科技计划项目管理办法》有关规定和要求。项目申报内容应符合指南中规定的重点支持方向和领域范围；项目目标任务应明确具体，体现项目创新性，技术指标应量化可考核，形成具有自主知识产权的技术成果。项目申报时，涉及人、实验动物等具有科技伦理风险的研究，应当按照《科技伦理审查办法》（国科发监〔2023〕167号）由申报单位科技伦理审查委员会审查批准。"},{"checklistNo":2,"checklistType":"流程","items":["建有研发机构并开展研发活动","项目经费由厦门市科技局筹集安排","项目后续管理由厦门市科技局负责"],"rawText":"（二）项目牵头申报单位原则上是在闽具有法人资格并具备科研开发能力和条件的企事业单位，规模以上工业企业申报省级科技计划项目，须建有研发机构并开展研发活动。其中，厦门市企事业单位可申报的项目，经评审立项后，项目经费由厦门市科技局筹集安排，项目后续管理由厦门市科技局负责。"},{"checklistNo":3,"checklistType":"时效","items":["不得有到期未验收的省科技计划项目"],"rawText":"（三）申报单位不得有到期未验收的省科技计划项目。"},{"checklistNo":4,"checklistType":"材料","items":["编制科技项目经费预算","实行经费包干制的项目不需编制经费预算","自筹解决差额部分"],"rawText":"（四）申报单位应按照《福建省级科技计划项目经费管理办法》的要求，编制科技项目经费预算（包括项目合作单位经费预算），实行经费包干制的项目不需编制经费预算。若省科技厅实际资助经费未达到申请额度，确需要补足差额部分的由项目申报单位自筹解决。"},{"checklistNo":5,"checklistType":"材料","items":["只能申请其中1个项目"],"rawText":"（五）企业作为牵头申报单位的，申报区域发展项目、科技型中小企业技术创新资金项目（包括技术创新项目和创新创业大赛获奖项目）、星火项目、对外合作项目、引导性项目、院省合作项目等类型项目时，只能申请其中1个项目。"},{"checklistNo":6,"checklistType":"材料","items":["项目负责人年龄不超过延迟退休后的法定退休年龄","企业牵头申报项目负责人年龄放宽到65周岁"],"rawText":"（六）项目负责人在项目结束时年龄原则上不超过延迟退休后的法定退休年龄；由企业牵头申报的项目，项目结束时负责人年龄可以放宽到65周岁。"},{"checklistNo":7,"checklistType":"材料","items":["项目负责人应为实际主持研究工作的科技人员或企业负责人","不得有到期未验收的省科技计划项目","政府公务人员不能作为项目负责人","科技人员当年度只能申请其中1个项目"],"rawText":"（七）项目负责人应为实际主持研究工作的科技人员或企业负责人，不得有到期未验收的省科技计划项目。政府公务人员不能作为项目负责人。科技人员作为项目负责人当年度只能申请其中1个项目（事后立项事后补助项目除外）。"},{"checklistNo":9,"checklistType":"材料","items":["提交合作协议作为申报材料附件","协议内容包括项目研究开发内容及分工、知识产权权属、经费筹措及资助经费分配"],"rawText":"（九）申报项目有合作单位的，应提交合作协议作为申报材料附件，协议内容一般包括：项目研究开发内容及分工、知识产权权属、经费筹措及资助经费分配等。"},{"checklistNo":10,"checklistType":"材料","items":["资助方式采取“事前立项、事后补助”"],"rawText":"（九）区域发展项目、对外合作产业化项目、科技型中小企业技术创新资金项目、星火项目等4类省级科技计划项目资助方式采取“事前立项、事后补助”。项目验收之后根据任务完成情况和项目投入情况给予项目补助。"},{"checklistNo":11,"checklistType":"材料","items":["提交科技报告"],"rawText":"（十）获批立项的省科技计划项目在实施完成或中期评估时，项目承担单位应根据《福建省科技计划项目科技报告暂行管理办法》及其实施方案要求，通过福建省科技计划项目信息管理系统提交科技报告。"},{"checklistNo":12,"checklistType":"材料","items":["建立研发准备金制度","通过福建省科技计划项目信息管理系统备案"],"rawText":"（十一）由企业牵头申报的省科技计划项目获批立项后，牵头企业应在项目实施期内建立研发准备金制度，并通过福建省科技计划项目信息管理系统备案。"}],"coverage":"empty","definitionNotes":[],"fusionPolicyId":"6486","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":[],"policyTitle":"福建省省属公益类科研院所基本科研项目申报","profileHash":"80bcfec8ef1a7bb0073da442b79712e3fb322fd1b2590c8b01279463fa628ffe","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[],"sourcePolicyUpdatedAt":"","sourceRuleTableHash":"2c19ecfee62d5c18e80d2f92dc990b066e0fb6d9a902a4d3a0c6f59dc3d1e512","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"材料","items":["提供申请、证明材料"],"rawText":"项目申报单位及项目负责人应保证提供的有关申请、证明材料真实可靠，并对信息虚假导致的后果承担责任。"},{"checklistNo":2,"checklistType":"流程","items":["加入福建省大型科研设施仪器管理服务平台"],"rawText":"购置的科研仪器设备软件原值在30万元（含）以上的应加入福建省大型科研设施仪器管理服务平台，向社会提供共享服务。"}],"coverage":"empty","definitionNotes":[],"fusionPolicyId":"6487","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":[],"policyTitle":"福建省省级新型研发机构非财政资金购买科研仪器设备软件后补助项目申报","profileHash":"60bab026f8ed91fa50b93a2fc6cca51c9cd624707dd4ffb1704809d219c4662d","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[],"sourcePolicyUpdatedAt":"2026-07-20 10:40:31.916880","sourceRuleTableHash":"e46549a1e2db955929f211a802a8ad7c38835d534e2121b209d209cdaeae51e6","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[{"checklistNo":1,"checklistType":"材料","items":["三方合作协议"],"rawText":"（二）项目应以有推荐权限的省内高校二级学院或系作为项目申请单位与合作企业（第一合作单位）联合申报，无推荐权限的高校应以独立法人作为申请单位；合作企业应是在闽注册、具有独立法人资格并具有一定规模的企业或市级以上农业产业化龙头企业。高校、合作企业及项目负责人应签订三方合作协议（格式下载网址：http://xmgl.kjt.fujian.gov.cn/）。"},{"checklistNo":2,"checklistType":"流程","items":["现场调研核实"],"rawText":"（四）高校、设区市管理部门对推荐的项目均应到合作企业现场进行调研核实，重点审核是否真实开展产学合作，项目研究成果是否能够落地转化。"},{"checklistNo":3,"checklistType":"时效","items":["研发起始时间：2026年5月1日","结束时间：2029年4月30日"],"rawText":"（六）项目实施期限为2-3年，申报项目研发起始时间为2026年5月1日，结束时间一般不超过2029年4月30日。"}],"coverage":"empty","definitionNotes":[],"fusionPolicyId":"6491","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":[],"policyTitle":"福建省高校产学合作项目申报","profileHash":"9fc83acb8341bc9a99bc5cc801ac5d8aa1bc45c651b5c8fac558b60d0b62ceef","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[],"sourcePolicyUpdatedAt":"2026-07-20 10:44:07.747686","sourceRuleTableHash":"636f00d8df54e9e7a0ca0a79885674c98fcf1ae886cd7ea4d3cbeb6bf131491c","sourceRuleTableVersion":"1.2","specialPassRuleGroups":[]}
{"applicationChecklistGroups":[],"coverage":"partial","definitionNotes":[],"fusionPolicyId":"6499","hardRuleGroups":[],"migrationStatus":"migrated","migrationWarnings":["存在 6 个未解析片段或条件项"],"policyTitle":"厦门市公共技术服务平台项目申报","profileHash":"6ce90cb75fa7a1216f331968f91af58dc7979abdfeb39a0d963bbdf69e8fe36b","schemaVersion":"pematching-v2-eligibility-profile-v1","softRuleGroups":[{"conditionBranchId":"C4-B1","conditionBranchText":"平台验收时应运营6个月以上，具有一定规模的市场服务业绩，技术服务收入占平台年度收入60%及以上，有较高水平的专职技术服务团队，有与服务能力匹配的场地、设施等硬件条件，其中，服务场所面积不少于500平方米，软硬件设施投入不低于总投入的30%，有健全的管理制度、规范的服务流程以及合理的收费标准，能够实现“自我造血”","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C4-B1","conditionBranchText":"平台验收时应运营6个月以上，具有一定规模的市场服务业绩，技术服务收入占平台年度收入60%及以上，有较高水平的专职技术服务团队，有与服务能力匹配的场地、设施等硬件条件，其中，服务场所面积不少于500平方米，软硬件设施投入不低于总投入的30%，有健全的管理制度、规范的服务流程以及合理的收费标准，能够实现“自我造血”","enterpriseFields":["运营时间"],"itemId":"4-1","itemName":"运营时间","itemStatus":"unresolved","matchRule":{"description":"运营时间不少于6个月","fieldType":"number","operator":"gte","ruleId":"S4-1","ruleKind":"reference","targetValue":6,"unit":"个月"},"policyFragment":"平台验收时应运营6个月以上","semanticItemKey":"6499:softRuleGroups:1:1","sourceFragmentId":"C4-A1","sourceStandardField":null}],"conditionNo":4,"conditionOperator":"AND","evaluationRole":"quantitative_signal","rawText":"平台验收时应运营6个月以上","unresolvedFragments":[]},{"conditionBranchId":"C4-B1","conditionBranchText":"平台验收时应运营6个月以上，具有一定规模的市场服务业绩，技术服务收入占平台年度收入60%及以上，有较高水平的专职技术服务团队，有与服务能力匹配的场地、设施等硬件条件，其中，服务场所面积不少于500平方米，软硬件设施投入不低于总投入的30%，有健全的管理制度、规范的服务流程以及合理的收费标准，能够实现“自我造血”","conditionContext":"","conditionFieldItems":[{"conditionBranchId":"C4-B1","conditionBranchText":"平台验收时应运营6个月以上，具有一定规模的市场服务业绩，技术服务收入占平台年度收入60%及以上，有较高水平的专职技术服务团队，有与服务能力匹配的场地、设施等硬件条件，其中，服务场所面积不少于500平方米，软硬件设施投入不低于总投入的30%，有健全的管理制度、规范的服务流程以及合理的收费标准，能够实现“自我造血”","enterpriseFields":["技术服务收入占比"],"itemId":"4-2","itemName":"技术服务收入占比","itemStatus":"unresolved","matchRule":{"description":"技术服务收入占平台年度收入60%及以上","fieldType":"number","operator":"gte","ruleId":"S4-2"