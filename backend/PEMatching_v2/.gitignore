# 环境配置（含密钥，不提交）
.env

# 运行产物
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep

# 四期运行结果归档（约 598 MB，仅本地保留）
结果文件/

# 生成物：由 run_sync_policies.py / run_policy_tagging.py 产出
# config/policy_snapshot.json
# config/policy_tags.json
# config/policy_tags.json.tmp
# config/policy_snapshot.json.tmp
config/policy_condition_snapshot.json
config/policy_condition_snapshot.json.tmp

# Python
__pycache__/
*.py[cod]
.pytest_cache/
