# PEMatching_v2 配置
# 复制为 .env 后按实际环境修改。所有变量统一 V2_ 前缀，与老链路 backend/PEMatching/.env 互不影响。

# ---------- LLM ----------
# 注意：Agent 的 tool-calling 目前只有 minimax2.7 可用。
# qwen3-8b / qwen3.6-35b 所在的 vLLM 未开 --enable-auto-tool-choice，传 tools 参数会返回 400。
V2_API_URL=http://127.0.0.1:30015/v1/chat/completions
V2_API_KEY=
V2_MODEL_NAME=minimax2.7

# 单次请求超时（秒）。政策打标上下文长（含适用性判断），实测 180 秒在并发下不够
V2_LLM_TIMEOUT=240
# 首次请求之外的额外重试次数
V2_LLM_RETRY=2
# 指数退避基础秒数：第 n 次重试等待 BACKOFF * 2^(n-1)
V2_LLM_BACKOFF=2

# ---------- 并发 ----------
# 政策打标、批跑企业的线程池上限。
# 实测（2026-08-03，minimax2.7）：20 并发打标大量超时，8 并发仍有 12/110 条超时，
# 3-4 并发稳定通过。打标上下文长（约 2-4k 字符）是主因。
# 批跑企业场景上下文较短，可用 --workers 参数按需上调。
V2_MAX_WORKERS=4

# ---------- 服务 ----------
V2_HOST=0.0.0.0
V2_PORT=8020

# ---------- 政策数据源 ----------
# v2 自己拉取并维护 config/policy_snapshot.json，不读老目录的 config/主政策申报条件.json
V2_STRUCTURE_API_BASE_URL=http://127.0.0.1:3000
V2_POLICY_PAGE_SIZE=100
V2_POLICY_API_TIMEOUT=30
# 政策列表过滤固定为 reviewStatus=1、structureReviewStatus=1、requireSourcePolicyId=1。
# 数量以接口 pagination.total 为准，不在配置或代码中写死。
PEMATCHING_V2_POLICY_SYNC_ON_STARTUP=true
PEMATCHING_V2_POLICY_SYNC_WORKERS=6
PEMATCHING_V2_POLICY_SYNC_RETRY=2
PEMATCHING_V2_POLICY_SYNC_BACKOFF=0.8
# 服务启动时自动从结构 API 同步资格规则快照（config/eligibility/policy_profiles.jsonl + manifest.json）。
# 与 V1 启动时生成主政策申报条件快照对应，V2 自给自足不依赖老目录文件。
PEMATCHING_V2_ELIGIBILITY_SYNC_ON_STARTUP=true
# 新匹配链路不执行旧 A-F 政策打标。只有旧链路灰度或回滚确有需要时才显式开启。
# 开启后会在后台增量处理旧标签文件，不阻塞服务启动。
PEMATCHING_V2_LEGACY_TAGGING_ON_STARTUP=false
# 默认使用新申报条件链路；仅故障回滚时临时改为 legacy。
# /api/v2/tagmatch/* 与 /api/v2/condition-match/* 均使用新条件匹配编排器。
PEMATCHING_V2_ENGINE=condition_llm
PEMATCHING_V2_POLICY_LLM_WORKERS=6
PEMATCHING_V2_POLICY_LLM_TIMEOUT=120
# 精简后通常不足 120 条；标准画像优先，超限仅裁剪兜底原始事实。
PEMATCHING_V2_POLICY_LLM_MAX_FACTS=120
PEMATCHING_V2_POLICY_LLM_RETRY_BACKOFF=0.5
PEMATCHING_V2_MATCH_CACHE_ENABLED=true
# 默认不归档模型输入输出。开启时仅写入已脱敏的条件包、企业事实和模型结果。
PEMATCHING_V2_MODEL_ARCHIVE_ENABLED=false

# ---------- Agent ----------
# tool 循环最大轮次，超限强制收尾并标记 truncated
V2_AGENT_MAX_TURNS=12
# 模型连续多少轮不调工具则降级到 deterministic
V2_AGENT_IDLE_LIMIT=2

# ---------- 接口约束 ----------
# batch 接口单次最大企业数
V2_BATCH_MAX_SIZE=50
# 单企业默认返回政策条数上限
V2_DEFAULT_TOP_N=20

# ---------- 一期统计用（只读引用，不修改该目录） ----------
V2_SAMPLE_ENTERPRISE_DIR=backend/PEMatching/企业测试目录
# 第五期资格门禁：模型只抽取逐条件企业事实，服务端负责回读、换算、比较和计分。
PEMATCHING_V2_ELIGIBILITY_ENABLED=true
PEMATCHING_V2_ELIGIBILITY_LLM_ENABLED=true
PEMATCHING_V2_ELIGIBILITY_LLM_RETRY=0
PEMATCHING_V2_ELIGIBILITY_ARCHIVE_ENABLED=true
PEMATCHING_V2_ELIGIBILITY_MAX_POLICIES=20
# 可选：指定某个资格规则快照的绝对路径；未设置时使用 config/eligibility/manifest.json。
# PEMATCHING_V2_ELIGIBILITY_RULE_MANIFEST=
