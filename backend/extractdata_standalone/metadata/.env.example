METADATA_API_URL=http://your-api-host/v1/chat/completions
METADATA_API_KEY=
METADATA_MODEL_NAME=your-model-name

METADATA_INPUT_DIRS=metadata/input
METADATA_OUTPUT_DIR=metadata/output

METADATA_REQUEST_TIMEOUT=150
METADATA_CONNECT_TIMEOUT=30
METADATA_MAX_TEXT_LENGTH=12000
METADATA_BATCH_SIZE=30
METADATA_MAX_WORKERS=10
METADATA_MAX_RETRIES=2
METADATA_TEMPERATURE=0.7

METADATA_PROMPT_FILE=metadata/prompts/policy_extract.md

METADATA_DB_HOST=
METADATA_DB_PORT=5237
METADATA_DB_NAME=
METADATA_DB_USER=
METADATA_DB_PASSWORD=
METADATA_DB_CHARSET=utf8

METADATA_DB_IMPORT_ENABLED=true
METADATA_DB_IMPORT_DRY_RUN=false
METADATA_DB_IMPORT_STAGE_DIR=metadata/output/_db_stage
METADATA_DB_IMPORT_FORCE_INSERT_POLICIES=false
